<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root_rl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentBottom="true">
    <View
        android:id="@+id/gradient"
        android:background="@drawable/gradient_onscreen_fingerprint_indicator"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/text_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="Scan fingerprint to unlock"
        android:layout_alignParentBottom="true"
        android:fontFamily="@font/demi_bold"/>
    <ImageView
        android:id="@+id/circle_fingerprint_iv"
        android:background="@drawable/onscreen_fp_indicator_circle"
        android:padding="19px"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:rotation="180"/>
</RelativeLayout>
