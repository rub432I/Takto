<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="right">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/urgent_action_btn"
        android:background="@drawable/rounded_corners_50dp_fill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:backgroundTint="@color/blloc_yellow"
        android:paddingVertical="7dp">
        <TextView
            android:textSize="15dp"
            android:id="@+id/action_text"
            android:paddingLeft="15dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"/>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_urgent_action"
            android:paddingHorizontal="10dp"/>
    </LinearLayout>
</merge>
