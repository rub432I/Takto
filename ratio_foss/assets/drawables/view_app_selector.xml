<?xml version="1.0" encoding="utf-8"?>
<com.blloc.uicomponents.old.customviews.ThemeableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxHeight="@dimen/bottom_sheet_max_height_app_selector"
    app:linearBackground_DARK="@color/bottom_sheet_background_dark"
    app:linearBackground_FOCUS="@color/bottom_sheet_background_focus"
    app:linearBackground_LIGHT="@color/bottom_sheet_background_light"
    app:linearBackground_SUN="@color/bottom_sheet_background_sun"
    app:linearLayout_corner_radius="@dimen/bottom_sheet_corners">
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:layout_width="@dimen/bottom_sheet_handle_width"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:layout_marginTop="@dimen/bottom_sheet_handle_marginT"
        android:layout_marginBottom="@dimen/bottom_sheet_handle_marginB"
        app:linearBackground_DARK="@color/bottom_sheet_handle_dark"
        app:linearBackground_FOCUS="@color/bottom_sheet_handle_focus"
        app:linearBackground_LIGHT="@color/bottom_sheet_handle_light"
        app:linearBackground_SUN="@color/bottom_sheet_handle_sun"
        app:linearLayout_corner_radius="@dimen/bottom_sheet_handle_corners"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="28sp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/drawer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/heavy"
        app:textColor_DARK="@color/bottom_sheet_text_dark"
        app:textColor_FOCUS="@color/bottom_sheet_text_focus"
        app:textColor_LIGHT="@color/bottom_sheet_text_light"
        app:textColor_SUN="@color/bottom_sheet_text_sun"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:gravity="top|center_horizontal"
            android:id="@+id/n_scrollview"
            android:paddingTop="16dp"
            android:paddingBottom="128dp"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="100dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="@dimen/bottom_sheet_max_height_app_selector"
            android:requiresFadingEdge="vertical"
            android:layout_marginHorizontal="34dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/app_selector_rv"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.core.widget.NestedScrollView>
        <ProgressBar
            android:id="@+id/apps_load_pb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:indeterminateTint="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/action_wrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/action_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/n_scrollview"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1">
            <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/confirm_button"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="30dp"
                app:linearBackground_DARK="@color/button_backgroundColor_dark"
                app:linearBackground_FOCUS="@color/button_backgroundColor_focus"
                app:linearBackground_LIGHT="@color/button_backgroundColor_light"
                app:linearBackground_SUN="@color/button_backgroundColor_sun"
                app:linearLayout_corner_radius="50dp">
                <com.blloc.uicomponents.old.customviews.ThemeableTextView
                    android:textSize="14sp"
                    android:gravity="center"
                    android:id="@+id/confirm_button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common.button.confirm"
                    android:fontFamily="@font/bold"
                    app:textColor_DARK="@color/button_textColor_dark"
                    app:textColor_FOCUS="@color/button_textColor_focus"
                    app:textColor_LIGHT="@color/button_textColor_light"
                    app:textColor_SUN="@color/button_textColor_sun"/>
            </com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:gravity="center"
                android:id="@+id/selected_count"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:textColor_DARK="@color/bottom_sheet_text_dark"
                app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                app:textColor_LIGHT="@color/bottom_sheet_text_light"
                app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
