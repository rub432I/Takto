<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/navigation_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        app:linearBackground_DARK="@color/onboarding_language_button_dark"
        app:linearBackground_FOCUS="@color/onboarding_language_button_dark"
        app:linearBackground_LIGHT="@color/onboarding_language_button_light"
        app:linearBackground_SUN="@color/onboarding_language_button_light"
        app:linearLayout_corner_radius="40dp">
        <com.blloc.uicomponents.old.customviews.ThemeableImageView
            android:id="@+id/navigation_item_iconL"
            android:layout_width="@dimen/onboarding_button_icon_width"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/onboarding_button_icon_margin"
            android:src="@drawable/ticket_arrow_right"
            android:adjustViewBounds="true"
            app:imageColor_DARK="@color/black"
            app:imageColor_FOCUS="@color/black"
            app:imageColor_LIGHT="@color/black"
            app:imageColor_SUN="@color/black"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/onboarding_button_text"
            android:gravity="center"
            android:id="@+id/navigation_item_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/demi_bold"
            app:textColor_DARK="@color/black"
            app:textColor_FOCUS="@color/black"
            app:textColor_LIGHT="@color/black"
            app:textColor_SUN="@color/black"/>
        <com.blloc.uicomponents.old.customviews.ThemeableImageView
            android:id="@+id/navigation_item_iconR"
            android:layout_width="@dimen/onboarding_button_icon_width"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/onboarding_button_icon_margin"
            android:src="@drawable/ticket_arrow_right"
            android:adjustViewBounds="true"
            app:imageColor_DARK="@color/black"
            app:imageColor_FOCUS="@color/black"
            app:imageColor_LIGHT="@color/black"
            app:imageColor_SUN="@color/black"/>
    </com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
</FrameLayout>
