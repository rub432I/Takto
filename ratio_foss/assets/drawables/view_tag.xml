<?xml version="1.0" encoding="utf-8"?>
<com.blloc.uicomponents.old.customviews.ThemeableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/tag_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:layout_marginRight="10dp"
    android:paddingHorizontal="5dp"
    android:paddingVertical="1dp"
    app:linearBackground_DARK="@color/tag_background_dark"
    app:linearBackground_FOCUS="@color/tag_background_focus"
    app:linearBackground_LIGHT="@color/tag_background_light"
    app:linearBackground_SUN="@color/tag_background_sun"
    app:linearLayout_corner_radius="50dp">
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="10sp"
        android:textColor="#000000"
        android:gravity="center_vertical"
        android:id="@+id/tag_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bold"
        app:textColor_DARK="@color/tag_text_dark"
        app:textColor_FOCUS="@color/tag_text_focus"
        app:textColor_LIGHT="@color/tag_text_light"
        app:textColor_SUN="@color/tag_text_sun"/>
</com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
