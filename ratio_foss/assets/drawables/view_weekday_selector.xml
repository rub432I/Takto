<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/weekday_selector"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.bllocjavatree.ui.utils.BllocButton
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/sun_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="@string/common.calendar.week_day_7_initial"
        app:animatable="false"
        app:buttonBllocStyle="circle_outline"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.blloc.bllocjavatree.ui.utils.BllocButton
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/mon_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="@string/common.calendar.week_day_1_initial"
        app:animatable="false"
        app:buttonBllocStyle="circle_outline"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.blloc.bllocjavatree.ui.utils.BllocButton
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/tue_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="@string/common.calendar.week_day_2_initial"
        app:animatable="false"
        app:buttonBllocStyle="circle_outline"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.blloc.bllocjavatree.ui.utils.BllocButton
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/wed_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="@string/common.calendar.week_day_3_initial"
        app:animatable="false"
        app:buttonBllocStyle="circle_outline"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.blloc.bllocjavatree.ui.utils.BllocButton
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/thur_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="@string/common.calendar.week_day_4_initial"
        app:animatable="false"
        app:buttonBllocStyle="circle_outline"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.blloc.bllocjavatree.ui.utils.BllocButton
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/fri_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="@string/common.calendar.week_day_5_initial"
        app:animatable="false"
        app:buttonBllocStyle="circle_outline"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.blloc.bllocjavatree.ui.utils.BllocButton
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/sat_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="@string/common.calendar.week_day_6_initial"
        app:animatable="false"
        app:buttonBllocStyle="circle_outline"/>
</LinearLayout>
