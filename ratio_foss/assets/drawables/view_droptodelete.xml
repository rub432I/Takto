<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <com.blloc.kotlintiles.ui.utils.DragTargetView
        android:id="@+id/btnCancel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.blloc.uicomponents.old.customviews.ThemeableImageView
                android:layout_width="@dimen/ratio_pill_icon_width"
                android:layout_height="@dimen/ratio_pill_icon_height"
                android:src="@drawable/ic_remove"
                app:imageColor_DARK="@color/drop_to_remove_button_content_DARK"
                app:imageColor_FOCUS="@color/drop_to_remove_button_content_DARK"
                app:imageColor_LIGHT="@color/drop_to_remove_button_content_DARK"
                app:imageColor_SUN="@color/drop_to_remove_button_content_SUN"/>
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/ratio_pill_label_text_size"
                android:gravity="bottom"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/common.button.cancel"
                android:fontFamily="@font/medium"
                android:paddingHorizontal="@dimen/ratio_pill_label_padding_horizontal"
                app:textColor_DARK="@color/drop_to_remove_button_content_DARK"
                app:textColor_FOCUS="@color/drop_to_remove_button_content_DARK"
                app:textColor_LIGHT="@color/drop_to_remove_button_content_DARK"
                app:textColor_SUN="@color/drop_to_remove_button_content_SUN"/>
        </LinearLayout>
    </com.blloc.kotlintiles.ui.utils.DragTargetView>
    <com.blloc.kotlintiles.ui.utils.DragTargetView
        android:id="@+id/btnRemove"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.blloc.uicomponents.old.customviews.ThemeableImageView
                android:id="@+id/iconLeft"
                android:layout_width="@dimen/ratio_pill_icon_width"
                android:layout_height="@dimen/ratio_pill_icon_height"
                android:src="@drawable/ic_remove"
                app:imageColor_DARK="@color/drop_to_remove_button_content_DARK"
                app:imageColor_FOCUS="@color/drop_to_remove_button_content_DARK"
                app:imageColor_LIGHT="@color/drop_to_remove_button_content_DARK"
                app:imageColor_SUN="@color/drop_to_remove_button_content_SUN"/>
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/ratio_pill_label_text_size"
                android:gravity="bottom"
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/tree.options.remove"
                android:fontFamily="@font/medium"
                android:paddingHorizontal="@dimen/ratio_pill_label_padding_horizontal"
                app:textColor_DARK="@color/drop_to_remove_button_content_DARK"
                app:textColor_FOCUS="@color/drop_to_remove_button_content_DARK"
                app:textColor_LIGHT="@color/drop_to_remove_button_content_DARK"
                app:textColor_SUN="@color/drop_to_remove_button_content_SUN"/>
        </LinearLayout>
    </com.blloc.kotlintiles.ui.utils.DragTargetView>
    <com.blloc.kotlintiles.ui.utils.DragTargetView
        android:id="@+id/btnUninstall"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.blloc.uicomponents.old.customviews.ThemeableImageView
                android:layout_width="@dimen/ratio_pill_icon_width"
                android:layout_height="@dimen/ratio_pill_icon_height"
                android:src="@drawable/ic_uninstall"
                app:imageColor_DARK="@color/drop_to_remove_button_content_DARK"
                app:imageColor_FOCUS="@color/drop_to_remove_button_content_DARK"
                app:imageColor_LIGHT="@color/drop_to_remove_button_content_DARK"
                app:imageColor_SUN="@color/drop_to_remove_button_content_SUN"/>
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:gravity="bottom"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/settings.uninstall.dialog.title"
                android:fontFamily="@font/medium"
                android:paddingHorizontal="@dimen/ratio_pill_label_padding_horizontal"
                app:textColor_DARK="@color/drop_to_remove_button_content_DARK"
                app:textColor_FOCUS="@color/drop_to_remove_button_content_DARK"
                app:textColor_LIGHT="@color/drop_to_remove_button_content_DARK"
                app:textColor_SUN="@color/drop_to_remove_button_content_SUN"/>
        </LinearLayout>
    </com.blloc.kotlintiles.ui.utils.DragTargetView>
</LinearLayout>
