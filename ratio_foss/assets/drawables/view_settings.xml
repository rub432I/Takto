<?xml version="1.0" encoding="utf-8"?>
<com.blloc.uicomponents.old.customviews.ThemeableBlurView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:foregroundColor_DARK="@color/transparent"
    app:foregroundColor_FOCUS="@color/inputbar_FOCUS"
    app:foregroundColor_LIGHT="@color/opacity_20"
    app:foregroundColor_SUN="@color/setting_sun_background">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bllocosn.ui.main.settings.customview.LockableNestedScrollView
            android:layout_gravity="bottom"
            android:id="@+id/settings_scrollview"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/fading_height"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/setting_nested_fading_area"
            android:animateLayoutChanges="true"
            android:requiresFadingEdge="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settings"
                android:paddingBottom="0dp"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/setting_margin_top"
                android:animateLayoutChanges="true">
                <com.blloc.uicomponents.old.customviews.ThemeableBlurView
                    android:orientation="vertical"
                    android:id="@+id/settings_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/settings_header_corner"
                    android:layout_marginBottom="@dimen/bottom_sheet_button_paddingH"
                    android:layout_marginHorizontal="@dimen/settings_item_paddingH"
                    android:paddingHorizontal="@dimen/floating_prompt_marginT"
                    app:blurDisabledColor_LIGHT="@color/gray_40"
                    app:cornerRadius="@dimen/settings_header_corner"
                    app:foregroundColor_DARK="@color/opacity_light_20"
                    app:foregroundColor_FOCUS="@color/inputbar_FOCUS"
                    app:foregroundColor_LIGHT="@color/opacity_20"
                    app:foregroundColor_SUN="@color/inputbar_SUN">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@color/transparent"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:paddingVertical="@dimen/version_padding_top">
                        <com.blloc.uicomponents.old.customviews.ThemeableImageView
                            android:layout_width="@dimen/floating_prompt_iconSize"
                            android:layout_height="@dimen/floating_prompt_iconSize"
                            android:layout_marginRight="@dimen/floating_prompt_corners"
                            android:src="@drawable/settings_icon_changelog"
                            app:imageColor_DARK="@color/white"
                            app:imageColor_FOCUS="@color/white"
                            app:imageColor_LIGHT="@color/white"
                            app:imageColor_SUN="@color/gray_50"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/floating_prompt_corners"
                            android:layout_weight="1">
                            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                                android:textSize="@dimen/settings_subtitle_size"
                                android:gravity="center_vertical"
                                android:id="@+id/settings_paywall_countdown_text"
                                android:paddingRight="@dimen/floating_prompt_paddingH"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/medium"
                                app:textColor_DARK="@color/white"
                                app:textColor_FOCUS="@color/white"
                                app:textColor_LIGHT="@color/white"
                                app:textColor_SUN="@color/gray_50"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.blloc.uicomponents.old.customviews.ThemeableBlurView>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/settings_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/setting_item_bottom_padding"
                    android:animateLayoutChanges="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/settings_general_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/setting_item_height"
                        android:paddingHorizontal="@dimen/setting_padding_horizontal">
                        <com.blloc.uicomponents.old.customviews.ThemeableImageView
                            android:id="@+id/general_settings_imageview"
                            android:layout_width="@dimen/setting_icon_size"
                            android:layout_height="@dimen/setting_icon_size"
                            app:imageColor_DARK="@color/white"
                            app:imageColor_FOCUS="@color/white"
                            app:imageColor_LIGHT="@color/white"
                            app:imageColor_SUN="@color/gray_50"
                            app:srcCompat="@drawable/general_settings_icon"/>
                        <com.blloc.uicomponents.old.customviews.ThemeableTextView
                            android:textSize="@dimen/settings_title_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings.category_general.label"
                            android:animateLayoutChanges="true"
                            android:fontFamily="@font/extra_bold"
                            android:paddingHorizontal="@dimen/settings_title_paddingH"
                            app:textColor_DARK="@color/white"
                            app:textColor_FOCUS="@color/white"
                            app:textColor_LIGHT="@color/white"
                            app:textColor_SUN="@color/gray_50"/>
                    </LinearLayout>
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/settings_general_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/settings_tiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/setting_item_bottom_padding"
                    android:animateLayoutChanges="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/settings_tiles_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/setting_item_height"
                        android:paddingHorizontal="@dimen/setting_padding_horizontal">
                        <com.blloc.uicomponents.old.customviews.ThemeableImageView
                            android:id="@+id/titles_settings_imageview"
                            android:layout_width="@dimen/setting_icon_size"
                            android:layout_height="@dimen/setting_icon_size"
                            app:imageColor_DARK="@color/white"
                            app:imageColor_FOCUS="@color/white"
                            app:imageColor_LIGHT="@color/white"
                            app:imageColor_SUN="@color/gray_50"
                            app:srcCompat="@drawable/tiles_seetings_icon"/>
                        <com.blloc.uicomponents.old.customviews.ThemeableTextView
                            android:textSize="@dimen/settings_title_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tiles"
                            android:animateLayoutChanges="true"
                            android:fontFamily="@font/extra_bold"
                            android:paddingHorizontal="@dimen/settings_title_paddingH"
                            app:textColor_DARK="@color/white"
                            app:textColor_FOCUS="@color/white"
                            app:textColor_LIGHT="@color/white"
                            app:textColor_SUN="@color/gray_50"/>
                    </LinearLayout>
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/settings_tiles_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/settings_tree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/setting_item_bottom_padding"
                    android:animateLayoutChanges="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/settings_tree_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/setting_item_height"
                        android:paddingHorizontal="@dimen/setting_padding_horizontal">
                        <com.blloc.uicomponents.old.customviews.ThemeableImageView
                            android:id="@+id/tree_settings_imageview"
                            android:layout_width="@dimen/setting_icon_size"
                            android:layout_height="@dimen/setting_icon_size"
                            app:imageColor_DARK="@color/white"
                            app:imageColor_FOCUS="@color/white"
                            app:imageColor_LIGHT="@color/white"
                            app:imageColor_SUN="@color/gray_50"
                            app:srcCompat="@drawable/conversations_settings_icon"/>
                        <com.blloc.uicomponents.old.customviews.ThemeableTextView
                            android:textSize="@dimen/settings_title_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Conversations"
                            android:animateLayoutChanges="true"
                            android:fontFamily="@font/extra_bold"
                            android:paddingHorizontal="@dimen/settings_title_paddingH"
                            app:textColor_DARK="@color/white"
                            app:textColor_FOCUS="@color/white"
                            app:textColor_LIGHT="@color/white"
                            app:textColor_SUN="@color/gray_50"/>
                    </LinearLayout>
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/settings_tree_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/settings_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/setting_item_bottom_padding"
                    android:animateLayoutChanges="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/settings_root_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/setting_item_height"
                        android:paddingHorizontal="@dimen/setting_padding_horizontal">
                        <com.blloc.uicomponents.old.customviews.ThemeableImageView
                            android:id="@+id/root_settings_imageview"
                            android:layout_width="@dimen/setting_icon_size"
                            android:layout_height="@dimen/setting_icon_size"
                            app:imageColor_DARK="@color/white"
                            app:imageColor_FOCUS="@color/white"
                            app:imageColor_LIGHT="@color/white"
                            app:imageColor_SUN="@color/gray_50"
                            app:srcCompat="@drawable/root_seetings_icon"/>
                        <com.blloc.uicomponents.old.customviews.ThemeableTextView
                            android:textSize="@dimen/settings_title_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Root"
                            android:animateLayoutChanges="true"
                            android:fontFamily="@font/extra_bold"
                            android:paddingHorizontal="@dimen/settings_title_paddingH"
                            app:textColor_DARK="@color/white"
                            app:textColor_FOCUS="@color/white"
                            app:textColor_LIGHT="@color/white"
                            app:textColor_SUN="@color/gray_50"/>
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/root_settings_fragment_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:paddingHorizontal="@dimen/settings_title_paddingH"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/settings_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/setting_item_bottom_padding"
                    android:animateLayoutChanges="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/settings_search_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/setting_item_height"
                        android:paddingHorizontal="@dimen/setting_padding_horizontal">
                        <com.blloc.uicomponents.old.customviews.ThemeableImageView
                            android:id="@+id/search_settings_imageview"
                            android:layout_width="@dimen/setting_icon_size"
                            android:layout_height="@dimen/setting_icon_size"
                            app:imageColor_DARK="@color/white"
                            app:imageColor_FOCUS="@color/white"
                            app:imageColor_LIGHT="@color/white"
                            app:imageColor_SUN="@color/gray_50"
                            app:srcCompat="@drawable/search_setting_icon"/>
                        <com.blloc.uicomponents.old.customviews.ThemeableTextView
                            android:textSize="@dimen/settings_title_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Search"
                            android:animateLayoutChanges="true"
                            android:fontFamily="@font/extra_bold"
                            android:paddingHorizontal="@dimen/settings_title_paddingH"
                            app:textColor_DARK="@color/white"
                            app:textColor_FOCUS="@color/white"
                            app:textColor_LIGHT="@color/white"
                            app:textColor_SUN="@color/gray_50"/>
                    </LinearLayout>
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/settings_search_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/settings_permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/setting_item_bottom_padding"
                    android:animateLayoutChanges="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/settings_permissions_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/setting_item_height"
                        android:paddingHorizontal="@dimen/setting_padding_horizontal">
                        <com.blloc.uicomponents.old.customviews.ThemeableImageView
                            android:id="@+id/permission_settings_imageview"
                            android:layout_width="@dimen/setting_icon_size"
                            android:layout_height="@dimen/setting_icon_size"
                            app:imageColor_DARK="@color/white"
                            app:imageColor_FOCUS="@color/white"
                            app:imageColor_LIGHT="@color/white"
                            app:imageColor_SUN="@color/gray_50"
                            app:srcCompat="@drawable/permissions_settings_icon"/>
                        <com.blloc.uicomponents.old.customviews.ThemeableTextView
                            android:textSize="@dimen/settings_title_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Permissions"
                            android:animateLayoutChanges="true"
                            android:fontFamily="@font/extra_bold"
                            android:paddingHorizontal="@dimen/settings_title_paddingH"
                            app:textColor_DARK="@color/white"
                            app:textColor_FOCUS="@color/white"
                            app:textColor_LIGHT="@color/white"
                            app:textColor_SUN="@color/gray_50"/>
                    </LinearLayout>
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/settings_permissions_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/settings_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/setting_item_bottom_padding"
                    android:animateLayoutChanges="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/settings_about_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/setting_item_height"
                        android:paddingHorizontal="@dimen/setting_padding_horizontal">
                        <com.blloc.uicomponents.old.customviews.ThemeableImageView
                            android:id="@+id/about_settings_imageview"
                            android:layout_width="@dimen/setting_icon_size"
                            android:layout_height="@dimen/setting_icon_size"
                            app:imageColor_DARK="@color/white"
                            app:imageColor_FOCUS="@color/white"
                            app:imageColor_LIGHT="@color/white"
                            app:imageColor_SUN="@color/gray_50"
                            app:srcCompat="@drawable/about_settings_icon"/>
                        <com.blloc.uicomponents.old.customviews.ThemeableTextView
                            android:textSize="@dimen/settings_title_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings.category_about.label"
                            android:animateLayoutChanges="true"
                            android:fontFamily="@font/extra_bold"
                            android:paddingHorizontal="@dimen/settings_title_paddingH"
                            app:textColor_DARK="@color/white"
                            app:textColor_FOCUS="@color/white"
                            app:textColor_LIGHT="@color/white"
                            app:textColor_SUN="@color/gray_50"/>
                    </LinearLayout>
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/settings_about_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/settings_devs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/setting_item_bottom_padding"
                    android:animateLayoutChanges="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/settings_devs_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/setting_item_height"
                        android:paddingHorizontal="@dimen/setting_padding_horizontal">
                        <com.blloc.uicomponents.old.customviews.ThemeableImageView
                            android:id="@+id/dev_settings_imageview"
                            android:layout_width="@dimen/setting_icon_size"
                            android:layout_height="@dimen/setting_icon_size"
                            app:imageColor_DARK="@color/white"
                            app:imageColor_FOCUS="@color/white"
                            app:imageColor_LIGHT="@color/white"
                            app:imageColor_SUN="@color/gray_50"
                            app:srcCompat="@drawable/dev_options_settings_icon"/>
                        <com.blloc.uicomponents.old.customviews.ThemeableTextView
                            android:textSize="@dimen/settings_title_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tree.settings.devs.title"
                            android:animateLayoutChanges="true"
                            android:fontFamily="@font/heavy"
                            android:paddingHorizontal="@dimen/settings_title_paddingH"
                            app:textColor_DARK="@color/white"
                            app:textColor_FOCUS="@color/white"
                            app:textColor_LIGHT="@color/white"
                            app:textColor_SUN="@color/gray_50"/>
                    </LinearLayout>
                    <com.bllocosn.ui.main.settings.devs.SettingsDevs
                        android:id="@+id/settings_devs_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"/>
                </LinearLayout>
            </LinearLayout>
        </com.bllocosn.ui.main.settings.customview.LockableNestedScrollView>
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbarLayout"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/appbar_expanded_height"
            android:animateLayoutChanges="true"
            app:elevation="@dimen/appbar_elevation"
            app:layout_behavior="com.bllocosn.ui.main.settings.customview.FixedAppBarLayoutBehavior">
            <androidx.constraintlayout.motion.widget.MotionLayout
                android:id="@+id/motionLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="@dimen/appbar_min_height"
                app:layoutDescription="@xml/view_settings_xml_motionlayout_scene"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.blloc.uicomponents.old.customviews.ThemeableTextView
                        android:textSize="@dimen/setting_title_text_size"
                        android:textColor="@color/white"
                        android:id="@+id/app_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_app_name_title"
                        android:fontFamily="@font/extra_bold"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:textColor_DARK="@color/white"
                        app:textColor_FOCUS="@color/white"
                        app:textColor_LIGHT="@color/white"
                        app:textColor_SUN="@color/gray_50"/>
                    <com.blloc.uicomponents.old.customviews.ThemeableTextView
                        android:textSize="@dimen/version_text_size"
                        android:textColor="@color/white"
                        android:id="@+id/version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/settings_app_version"
                        android:foregroundGravity="right"
                        android:fontFamily="@font/extra_bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:textColor_DARK="@color/white"
                        app:textColor_FOCUS="@color/white"
                        app:textColor_LIGHT="@color/white"
                        app:textColor_SUN="@color/gray_50"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.blloc.uicomponents.old.customviews.ThemeableTextView
                    android:textSize="@dimen/setting_text_size"
                    android:textColor="@color/white"
                    android:id="@+id/setting_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:fontFamily="@font/medium"
                    android:textAlignment="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:textColor_DARK="@color/white"
                    app:textColor_FOCUS="@color/white"
                    app:textColor_LIGHT="@color/white"
                    app:textColor_SUN="@color/gray_50"/>
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="@dimen/setting_image_width"
                    android:layout_height="@dimen/setting_image_height"
                    android:layout_marginBottom="@dimen/setting_image_margin_bottom"
                    android:src="@drawable/ratio_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.motion.widget.MotionLayout>
        </com.google.android.material.appbar.AppBarLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.blloc.uicomponents.old.customviews.ThemeableBlurView>
