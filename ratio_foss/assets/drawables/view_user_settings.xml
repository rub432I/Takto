<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="@dimen/user_settings_weight_left">
            <com.blloc.blurview.BlurView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/user_settings_item_margin"
                app:cornerRadius="@dimen/conversation_header_corner_radius">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
                    android:id="@+id/platforms_view"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="@dimen/user_settings_weight_left"
                    app:linearBackground_DARK="@color/conversationSettings_dark"
                    app:linearBackground_FOCUS="@color/conversationSettings_focus"
                    app:linearBackground_LIGHT="@color/conversationSettings_light"
                    app:linearBackground_SUN="@color/conversationSettings_sun">
                    <com.blloc.bllocjavatree.ui.sections.conversation.settings.PlatformsView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
            </com.blloc.blurview.BlurView>
            <com.blloc.blurview.BlurView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/user_settings_item_margin"
                android:layout_marginRight="@dimen/user_settings_item_margin"
                app:cornerRadius="@dimen/conversation_header_corner_radius">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
                    android:id="@+id/choose_tags_view_container"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="@dimen/user_settings_weight_left"
                    app:linearBackground_DARK="@color/conversationSettings_dark"
                    app:linearBackground_FOCUS="@color/conversationSettings_focus"
                    app:linearBackground_LIGHT="@color/conversationSettings_light"
                    app:linearBackground_SUN="@color/conversationSettings_sun">
                    <com.blloc.bllocjavatree.ui.sections.conversation.settings.choosetags.ChooseTagsSettingsView
                        android:id="@+id/choose_tags_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
            </com.blloc.blurview.BlurView>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="@dimen/user_settings_weight_right">
            <com.blloc.bllocjavatree.ui.sections.conversation.settings.UserSettingsButton
                android:id="@+id/pin_btn"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:iconResOff="@drawable/ic_usersettings_pin"
                app:iconResOn="@drawable/ic_usersettings_unpin"
                app:labelTextOff="@string/tree.options.pin"
                app:labelTextOn="@string/tree.options.unpin"/>
            <com.blloc.bllocjavatree.ui.sections.conversation.settings.UserSettingsButton
                android:id="@+id/archive_btn"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/user_settings_item_margin"
                android:layout_marginBottom="@dimen/user_settings_item_margin_half"
                android:layout_weight="1"
                app:iconResOff="@drawable/ic_usersettings_archive"
                app:iconResOn="@drawable/ic_usersettings_unarchive"
                app:labelTextOff="@string/tree.options.archive"
                app:labelTextOn="@string/tree.options.unarchive"/>
            <com.blloc.bllocjavatree.ui.sections.conversation.settings.UserSettingsButton
                android:id="@+id/mute_btn"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/user_settings_item_margin_half"
                android:layout_weight="1"
                app:iconResOff="@drawable/ic_usersettings_unmute"
                app:iconResOn="@drawable/ic_usersettings_mute"
                app:labelTextOff="@string/tree.options.mute"
                app:labelTextOn="@string/tree.options.unmute"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
