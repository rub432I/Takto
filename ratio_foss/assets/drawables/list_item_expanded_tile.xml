<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view_rl"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="138dp">
    <com.blloc.blurview.BlurView
        android:id="@+id/blur_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.blloc.bllocjavatiles.tile_view.BllocTileView
        android:id="@+id/tile_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="9dp"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/shortcuts_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="9dp"
        android:weightSum="100"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="5dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="50">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/shortcut_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxWidth="50dp"
                android:weightSum="3"
                android:layout_weight="1">
                <TextView
                    android:textColor="#383838"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/shortcut_1_text"
                    android:background="@drawable/tile_shortcut_pill_background_light_white"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text=""
                    android:maxLines="1"
                    android:layout_weight="1.5"
                    android:fontFamily="@font/medium"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9dp"
                    android:layout_marginHorizontal="5dp"
                    android:paddingHorizontal="20dp"
                    android:autoSizeMaxTextSize="11dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/shortcut_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxWidth="50dp"
                android:weightSum="3"
                android:layout_weight="1">
                <TextView
                    android:textColor="#383838"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/shortcut_2_text"
                    android:background="@drawable/tile_shortcut_pill_background_light_white"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text=""
                    android:maxLines="1"
                    android:layout_weight="1.5"
                    android:fontFamily="@font/medium"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9dp"
                    android:layout_marginHorizontal="5dp"
                    android:paddingHorizontal="20dp"
                    android:autoSizeMaxTextSize="11dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
