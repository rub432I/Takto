<?xml version="1.0" encoding="utf-8"?>
<com.blloc.uicomponents.old.customviews.ThemeableBlurView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blurViewConversationsOnboarding"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginVertical="9dp"
    app:cornerRadius="8dp"
    app:foregroundColor_DARK="@color/gray_50"
    app:foregroundColor_FOCUS="@color/gray_80"
    app:foregroundColor_LIGHT="@color/gray_25"
    app:foregroundColor_SUN="@color/gray_10">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clConversationsOnboarding"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/SelectableItemBackground">
        <com.blloc.uicomponents.old.customviews.ThemeableImageView
            android:id="@+id/imageViewConversation"
            android:background="@drawable/icon_settings_rationotifications"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:tint="@color/white"
            android:layout_marginStart="16dp"
            android:backgroundTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/fp_prompt_complete_conversations_setup"
            android:fontFamily="@font/medium"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/imageViewConversation"
            app:layout_constraintStart_toEndOf="@+id/imageViewConversation"
            app:layout_constraintTop_toTopOf="@+id/imageViewConversation"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_50"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.blloc.uicomponents.old.customviews.ThemeableBlurView>
