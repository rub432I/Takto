<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_rl"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false">
    <View
        android:id="@+id/edit_mode_background"
        android:background="#000000"
        android:focusable="false"
        android:visibility="visible"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.blloc.bllocjavatiles.recyclerview.OverScrollView
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/overscroll_listener_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="false">
        <View
            android:id="@+id/drag_progress"
            android:background="#ffffff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"/>
        <com.blloc.bllocjavatiles.recyclerview.BllocRecyclerView
            android:id="@+id/tiles_rv"
            android:paddingLeft="0dp"
            android:paddingTop="50dp"
            android:paddingRight="0dp"
            android:paddingBottom="50dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:isScrollContainer="false"/>
    </com.blloc.bllocjavatiles.recyclerview.OverScrollView>
    <TextView
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/edit_mode_save_btn"
        android:background="@drawable/view_app_edit_screen_save_button_background"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="50.4dp"
        android:layout_marginBottom="12dp"
        android:text="@string/common.button.done"
        android:layout_alignParentBottom="true"
        android:alpha="0"
        android:fontFamily="@font/bold"
        android:layout_marginHorizontal="12dp"/>
    <com.blloc.bllocjavatiles.custom_views.OnScreenFingerprintIndicatorView
        android:id="@+id/fingerprint_indicator_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <com.blloc.bllocjavatiles.custom_views.DragTutorialView
        android:id="@+id/drag_tutorial_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/view_header_edit_menu"/>
    <com.blloc.bllocjavatiles.custom_views.BiometricAuthView
        android:id="@+id/biometric_auth_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.blloc.bllocjavatiles.custom_views.LockDeviceView
        android:id="@+id/view_doubletap_lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.blloc.bllocjavatiles.onboarding2.OnboardingView
        android:id="@+id/onboarding_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
