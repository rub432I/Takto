<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:linearBackground_DARK="@color/gray_90"
        app:linearBackground_FOCUS="@color/gray_90"
        app:linearBackground_LIGHT="@color/gray_90"
        app:linearBackground_SUN="@color/gray_10"
        app:linearLayout_corner_radius="10dp">
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/focus_hour_row_weekday_selector_tv"
            android:paddingLeft="10dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.focus_hours.text.repeats"
            android:fontFamily="@font/medium"
            android:layout_marginVertical="5dp"
            app:textColor_DARK="@color/settingTextTertiary_dark"
            app:textColor_FOCUS="@color/settingTextTertiary_focus"
            app:textColor_LIGHT="@color/settingTextTertiary_light"
            app:textColor_SUN="@color/settingTextTertiary_sun"/>
        <com.blloc.bllocjavatree.ui.utils.WeekdaySelector
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/focus_hour_row_weekday_selector"
            android:background="@color/transparent"
            android:paddingLeft="10dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.focus_hours.text.from"
            android:fontFamily="@font/medium"
            android:layout_marginVertical="5dp"
            app:textColor_DARK="@color/settingTextTertiary_dark"
            app:textColor_FOCUS="@color/settingTextTertiary_focus"
            app:textColor_LIGHT="@color/settingTextTertiary_light"
            app:textColor_SUN="@color/settingTextTertiary_sun"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/start_time_tv"
            android:paddingLeft="10dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="..."
            android:fontFamily="@font/demi_bold"
            app:textColor_DARK="@color/settingTextMain_dark"
            app:textColor_FOCUS="@color/settingTextMain_focus"
            app:textColor_LIGHT="@color/settingTextMain_light"
            app:textColor_SUN="@color/settingTextMain_sun"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.focus_hours.text.until"
            android:fontFamily="@font/medium"
            android:layout_marginVertical="5dp"
            app:textColor_DARK="@color/settingTextTertiary_dark"
            app:textColor_FOCUS="@color/settingTextTertiary_focus"
            app:textColor_LIGHT="@color/settingTextTertiary_light"
            app:textColor_SUN="@color/settingTextTertiary_sun"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/end_time_tv"
            android:paddingLeft="10dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:fontFamily="@font/demi_bold"
            android:layout_marginVertical="5dp"
            app:textColor_DARK="@color/settingTextMain_dark"
            app:textColor_FOCUS="@color/settingTextMain_focus"
            app:textColor_LIGHT="@color/settingTextMain_light"
            app:textColor_SUN="@color/settingTextMain_sun"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gray_1"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/action_btn"
            android:background="@drawable/rounded_corners_50dp_fill"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:text="@string/common.button.delete"
            android:fontFamily="@font/demi_bold"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#ffffff"
            android:layout_marginVertical="10dp"
            android:paddingHorizontal="5dp"/>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
</merge>
