<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/input_bar_margin">
    <com.blloc.uicomponents.old.customviews.ThemeableBlurView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/input_bar_height"
        android:layout_marginVertical="@dimen/input_bar_margin"
        app:blurDisabledColor_DARK="@color/inputbar_opaque_DARK"
        app:blurDisabledColor_FOCUS="@color/inputbar_opaque_FOCUS"
        app:blurDisabledColor_LIGHT="@color/inputbar_opaque_LIGHT"
        app:blurDisabledColor_SUN="@color/inputbar_opaque_SUN"
        app:cornerRadius="22.5dp"
        app:foregroundColor_DARK="@color/inputbar_DARK"
        app:foregroundColor_FOCUS="@color/inputbar_FOCUS"
        app:foregroundColor_LIGHT="@color/inputbar_LIGHT"
        app:foregroundColor_SUN="@color/inputbar_SUN">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="13.5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.blloc.uicomponents.old.customviews.ThemeableImageView
                android:id="@+id/send_media_btn"
                android:visibility="visible"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="9dp"
                android:src="@drawable/ic_inputbar_btn_media"
                app:imageColor_DARK="@color/inputbarIcon_DARK"
                app:imageColor_FOCUS="@color/inputbarIcon_FOCUS"
                app:imageColor_LIGHT="@color/inputbarIcon_LIGHT"
                app:imageColor_SUN="@color/inputbarIcon_SUN"/>
            <com.blloc.uicomponents.old.customviews.ThemeableEditText
                android:textSize="14dp"
                android:layout_gravity="center_vertical"
                android:id="@+id/input"
                android:background="@color/transparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Tap to search"
                android:maxLines="5"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone"
                android:fontFamily="@font/medium"
                android:paddingHorizontal="9dp"
                android:paddingVertical="10dp"
                app:textColor_DARK="@color/inputbarIcon_DARK"
                app:textColor_FOCUS="@color/inputbarIcon_FOCUS"
                app:textColor_LIGHT="@color/white"
                app:textColor_SUN="@color/inputbarIcon_SUN"/>
            <com.bllocosn.ui.main.common.inputbar.InputActionView
                android:id="@+id/inputActionView"
                android:padding="9dp"
                android:layout_width="45dp"
                android:layout_height="45dp"
                app:imageColor_DARK="@color/inputbarIcon_DARK"
                app:imageColor_FOCUS="@color/inputbarIcon_FOCUS"
                app:imageColor_LIGHT="@color/inputbarIcon_LIGHT"
                app:imageColor_SUN="@color/inputbarIcon_SUN"/>
        </LinearLayout>
    </com.blloc.uicomponents.old.customviews.ThemeableBlurView>
</RelativeLayout>
