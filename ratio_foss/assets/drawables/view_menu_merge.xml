<?xml version="1.0" encoding="utf-8"?>
<com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/merge_conversations_opacity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:linearBackground_DARK="@color/backgroundOpacity_dark"
    app:linearBackground_FOCUS="@color/backgroundOpacity_focus"
    app:linearBackground_LIGHT="@color/backgroundOpacity_light"
    app:linearBackground_SUN="@color/backgroundOpacity_sun">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/merge_conversations_menu"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="500dp"
        android:paddingHorizontal="@dimen/conversation_options_hPadding"
        android:paddingVertical="@dimen/conversation_options_vPadding">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingBottom="40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                android:textSize="@dimen/conversation_options_title"
                android:textColor="@color/white"
                android:id="@+id/merge_conversations_title"
                android:paddingBottom="@dimen/merge_title_bottom_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tree.merge.title.merge"
                android:maxLines="2"
                android:fontFamily="@font/extra_bold"
                android:textAlignment="center"
                app:textColor_DARK="@color/conversationOptionsText_dark"
                app:textColor_FOCUS="@color/conversationOptionsText_focus"
                app:textColor_LIGHT="@color/conversationOptionsText_light"
                app:textColor_SUN="@color/conversationOptionsText_sun"/>
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                android:textSize="@dimen/conversation_options_owner"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/merge_conversations_owner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="@font/medium"
                android:textAlignment="center"
                app:textColor_DARK="@color/conversationOptionsText_dark"
                app:textColor_FOCUS="@color/conversationOptionsText_focus"
                app:textColor_LIGHT="@color/conversationOptionsText_light"
                app:textColor_SUN="@color/conversationOptionsText_sun"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/merge_unmerge_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/merge_unmerge_list"
                android:background="@color/transparent"
                android:paddingBottom="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.sections.mainscreen.conversationoptions.MergeListItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.blloc.bllocjavatree.ui.sections.mainscreen.conversationoptions.MergeListItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.blloc.bllocjavatree.ui.sections.mainscreen.conversationoptions.UnmergeItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/merge_conversations_message_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                    android:textSize="@dimen/conversation_options_owner"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/merge_unmerge_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tree.merge.text.confirmation"
                    android:fontFamily="@font/medium"
                    android:textAlignment="center"
                    android:paddingHorizontal="30dp"
                    app:textColor_DARK="@color/conversationOptionsText_dark"
                    app:textColor_FOCUS="@color/conversationOptionsText_focus"
                    app:textColor_LIGHT="@color/conversationOptionsText_light"
                    app:textColor_SUN="@color/conversationOptionsText_sun"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/merge_unmerge_options_container"
                android:paddingTop="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                    android:id="@+id/merge_option_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonIsFilled="false"
                    app:buttonText="@string/common.button.no"
                    app:buttonType="Cancel"/>
                <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                    android:id="@+id/merge_option_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonIsFilled="true"
                    app:buttonText="@string/common.button.yes"
                    app:buttonType="Confirm"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/choose_merge_alias_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/choose_merge_alias"
                android:paddingBottom="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/choose_merge_alias_message_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                    android:textSize="@dimen/conversation_options_owner"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/choose_merge_alias_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tree.merge.text.select_main"
                    android:fontFamily="@font/medium"
                    android:textAlignment="center"
                    android:paddingHorizontal="30dp"
                    app:textColor_DARK="@color/conversationOptionsText_dark"
                    app:textColor_FOCUS="@color/conversationOptionsText_focus"
                    app:textColor_LIGHT="@color/conversationOptionsText_light"
                    app:textColor_SUN="@color/conversationOptionsText_sun"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/choose_merge_alias_options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                    android:id="@+id/choose_merge_alias_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonIsFilled="true"
                    app:buttonText="@string/common.button.done"
                    app:buttonType="Confirm"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
