<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="30dp">
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="@dimen/sales_page_title"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingTop="@dimen/sales_page_large_paddingT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New User Demo Test"
        android:fontFamily="@font/heavy"
        app:textColor_DARK="@color/salespage_text_dark"
        app:textColor_FOCUS="@color/salespage_text_dark"
        app:textColor_LIGHT="@color/salespage_text_light"
        app:textColor_SUN="@color/salespage_text_light"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="@dimen/sales_page_description_small"
        android:gravity="center"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set the offset days from current timestamp\10E.g: -1 for yesterday, 7 for next week "
        android:fontFamily="@font/medium"
        android:paddingHorizontal="@dimen/sales_page_large_paddingHorizontal"
        android:paddingVertical="@dimen/sales_page_large_paddingT"
        app:textColor_DARK="@color/salespage_text_dark"
        app:textColor_FOCUS="@color/salespage_text_dark"
        app:textColor_LIGHT="@color/salespage_text_light"
        app:textColor_SUN="@color/salespage_text_light"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <EditText
            android:textColor="@color/white"
            android:id="@+id/input_et"
            android:background="@drawable/rounded_corners_50dp_outline"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:fontFamily="@font/medium"
            android:backgroundTint="@color/white"
            android:paddingHorizontal="15dp"/>
        <com.blloc.uicomponents.buttons.BllocButton
            android:id="@+id/set_timestamp_offset_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
            app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
            app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
            app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
            app:button_isFilled="false"
            app:button_text="@string/common.button.set"
            app:button_textColor_DARK="@color/button_textColor_dark"
            app:button_textColor_FOCUS="@color/button_textColor_focus"
            app:button_textColor_LIGHT="@color/button_textColor_light"
            app:button_textColor_SUN="@color/button_textColor_sun"
            app:button_textSize="@dimen/onboarding_button_text"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:text="Reset FP dates: "
            android:fontFamily="@font/medium"/>
        <com.blloc.uicomponents.buttons.BllocButton
            android:id="@+id/reset_fp_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
            app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
            app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
            app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
            app:button_isFilled="false"
            app:button_text="@string/common.button.reset"
            app:button_textColor_DARK="@color/button_textColor_dark"
            app:button_textColor_FOCUS="@color/button_textColor_focus"
            app:button_textColor_LIGHT="@color/button_textColor_light"
            app:button_textColor_SUN="@color/button_textColor_sun"
            app:button_textSize="@dimen/onboarding_button_text"/>
    </LinearLayout>
</LinearLayout>
