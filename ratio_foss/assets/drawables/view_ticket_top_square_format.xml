<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_container"
    android:paddingTop="10dp"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="30dp">
    <ImageView
        android:id="@+id/ticket_qr"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.5"/>
    <TextView
        android:textSize="20px"
        android:textColor="@color/ticket_top_text_title"
        android:id="@+id/passengerNameTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/view_ticket_top_square_right_info_margin_left"
        android:fontFamily="@font/heavy"
        app:layout_constraintBottom_toTopOf="@+id/separator_1"
        app:layout_constraintLeft_toRightOf="@+id/ticket_qr"
        app:layout_constraintTop_toTopOf="@+id/ticket_qr"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <View
        android:id="@+id/separator_1"
        android:background="#000000"
        android:layout_width="50dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/view_ticket_top_square_right_info_margin_left"
        android:layout_marginVertical="5dp"
        app:layout_constraintBottom_toTopOf="@+id/flight_IATATV"
        app:layout_constraintLeft_toRightOf="@+id/ticket_qr"
        app:layout_constraintTop_toBottomOf="@+id/passengerNameTV"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <TextView
        android:textSize="20px"
        android:textColor="@color/ticket_top_text_title"
        android:id="@+id/flight_IATATV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/view_ticket_top_square_right_info_margin_left"
        android:fontFamily="@font/bold"
        app:layout_constraintBottom_toTopOf="@+id/separator_2"
        app:layout_constraintLeft_toRightOf="@+id/ticket_qr"
        app:layout_constraintTop_toBottomOf="@+id/separator_1"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <View
        android:id="@+id/separator_2"
        android:background="#000000"
        android:layout_width="50dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/view_ticket_top_square_right_info_margin_left"
        android:layout_marginVertical="5dp"
        app:layout_constraintBottom_toTopOf="@+id/seatContainerLL"
        app:layout_constraintLeft_toRightOf="@+id/ticket_qr"
        app:layout_constraintTop_toBottomOf="@+id/flight_IATATV"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/seatContainerLL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/view_ticket_top_square_right_info_margin_left"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ticket_qr"
        app:layout_constraintLeft_toRightOf="@+id/ticket_qr"
        app:layout_constraintTop_toBottomOf="@+id/separator_2">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ticket_top_text_title"
            android:id="@+id/seatTitleTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seat"
            android:fontFamily="@font/bold"
            app:layout_constraintBottom_toTopOf="@+id/seatTV"
            app:layout_constraintLeft_toRightOf="@+id/ticket_qr"
            app:layout_constraintTop_toBottomOf="@+id/separator_2"
            app:layout_constraintVertical_weight="5"/>
        <TextView
            android:textSize="50dp"
            android:textColor="@color/ticket_top_text_title"
            android:gravity="bottom"
            android:id="@+id/seatTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/heavy"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10dp"
            android:autoSizeMaxTextSize="60dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
