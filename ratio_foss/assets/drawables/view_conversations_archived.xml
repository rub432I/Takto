<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/archived_conversations_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/archived_conversations_header"
        android:paddingTop="@dimen/grouped_header_padding_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/grouped_header_margin_top"
        android:layout_marginBottom="@dimen/grouped_header_margin_bottom"
        android:paddingHorizontal="@dimen/grouped_header_padding_horizontal">
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableImageView
            android:id="@+id/option_icon"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="1dp"
            android:src="@drawable/ic_option_archive"
            android:adjustViewBounds="true"
            app:imageColor_DARK="@color/title_dark"
            app:imageColor_FOCUS="@color/title_focus"
            app:imageColor_LIGHT="@color/title_light"
            app:imageColor_SUN="@color/title_sun"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="@dimen/main_title_font_size"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/archived_conversations_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.ui.misc.archive_title"
            android:fontFamily="@font/bold"
            app:textColor_DARK="@color/title_dark"
            app:textColor_FOCUS="@color/title_focus"
            app:textColor_LIGHT="@color/title_light"
            app:textColor_SUN="@color/title_sun"/>
    </LinearLayout>
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
        android:textSize="15sp"
        android:textColor="#fff"
        android:gravity="end"
        android:id="@+id/archived_found"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="0"
        android:fontFamily="@font/medium"
        android:layout_marginStart="15dp"
        android:elevation="2dp"
        app:textColor_DARK="@color/subtitle_dark"
        app:textColor_FOCUS="@color/subtitle_focus"
        app:textColor_LIGHT="@color/subtitle_light"
        app:textColor_SUN="@color/subtitle_sun"/>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.blloc.bllocjavatree.ui.sections.mainscreen.archivedconversations.ArchivedConversationsView
            android:orientation="vertical"
            android:id="@+id/archived_conversations_list"
            android:paddingTop="@dimen/card_padding_subtitle"
            android:paddingBottom="@dimen/card_vertical_padding"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:alpha="1"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="15sp"
            android:textColor="#fff"
            android:gravity="end"
            android:id="@+id/archived_empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.ui.misc.num_conversations_none.archived"
            android:layout_centerVertical="true"
            android:fontFamily="@font/medium"
            android:layout_marginStart="15dp"
            android:elevation="2dp"
            android:layout_marginVertical="15dp"
            app:textColor_DARK="@color/text_dark"
            app:textColor_FOCUS="@color/text_focus"
            app:textColor_LIGHT="@color/text_light"
            app:textColor_SUN="@color/text_sun"/>
    </RelativeLayout>
</LinearLayout>
