<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/add_focus_hour_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:linearBackground_DARK="@color/backgroundOpacity_dark"
        app:linearBackground_FOCUS="@color/backgroundOpacity_focus"
        app:linearBackground_LIGHT="@color/backgroundOpacity_light"
        app:linearBackground_SUN="@color/backgroundOpacity_sun"
        app:linearLayout_corner_radius="0dp">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/add_focus_hour_menu"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="400dp"
            android:paddingHorizontal="50dp"
            android:paddingVertical="@dimen/conversation_options_vPadding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                android:textSize="30dp"
                android:textColor="@color/gray_20"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:text="@string/tree.focus_hours.title.add"
                android:fontFamily="@font/bold"
                app:textColor_DARK="@color/settingTextMain_dark"
                app:textColor_FOCUS="@color/settingTextMain_focus"
                app:textColor_LIGHT="@color/settingTextMain_light"
                app:textColor_SUN="@color/settingTextMain_sun"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                    android:textSize="16dp"
                    android:textColor="@color/gray_20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tree.focus_hours.text.repeat"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    app:textColor_DARK="@color/settingTextMain_dark"
                    app:textColor_FOCUS="@color/settingTextMain_focus"
                    app:textColor_LIGHT="@color/settingTextMain_light"
                    app:textColor_SUN="@color/settingTextMain_sun"/>
                <com.blloc.bllocjavatree.ui.utils.BllocSwitch
                    android:textColor="@color/gray_70"
                    android:layout_gravity="right"
                    android:id="@+id/focus_hour_repeat_switch"
                    android:background="@drawable/rounded_corners_50dp_fill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/gray_20"
                    app:checked="false"/>
            </LinearLayout>
            <com.blloc.bllocjavatree.ui.utils.WeekdaySelector
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/focus_hour_repeat_date_selector"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="30dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                    android:textSize="16dp"
                    android:textColor="@color/gray_20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tree.focus_hours.text.start"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    app:textColor_DARK="@color/settingTextMain_dark"
                    app:textColor_FOCUS="@color/settingTextMain_focus"
                    app:textColor_LIGHT="@color/settingTextMain_light"
                    app:textColor_SUN="@color/settingTextMain_sun"/>
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBllocButton
                    android:textSize="12dp"
                    android:textColor="@color/gray_1"
                    android:gravity="center"
                    android:id="@+id/focus_hour_start_time_set_btn"
                    android:background="@drawable/rounded_corners_50dp_fill"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:text="@string/common.button.set"
                    android:fontFamily="@font/demi_bold"
                    android:backgroundTint="#ffffff"
                    app:buttonBllocStyle="outline"
                    app:textColor_DARK="@color/white"
                    app:textColor_FOCUS="@color/white"
                    app:textColor_LIGHT="@color/white"
                    app:textColor_SUN="@color/gray_50"/>
            </LinearLayout>
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                android:textSize="16dp"
                android:textColor="@color/gray_20"
                android:id="@+id/focus_hour_start_time_selected_tv"
                android:paddingTop="5dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                app:textColor_DARK="@color/settingTextSecondary_dark"
                app:textColor_FOCUS="@color/settingTextSecondary_focus"
                app:textColor_LIGHT="@color/settingTextSecondary_light"
                app:textColor_SUN="@color/settingTextSecondary_sun"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                    android:textSize="16dp"
                    android:textColor="@color/gray_20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tree.focus_hours.text.end"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    app:textColor_DARK="@color/settingTextMain_dark"
                    app:textColor_FOCUS="@color/settingTextMain_focus"
                    app:textColor_LIGHT="@color/settingTextMain_light"
                    app:textColor_SUN="@color/settingTextMain_sun"/>
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBllocButton
                    android:textSize="12dp"
                    android:textColor="@color/gray_1"
                    android:gravity="center"
                    android:id="@+id/focus_hour_end_time_set_btn"
                    android:background="@drawable/rounded_corners_50dp_fill"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:text="@string/common.button.set"
                    android:fontFamily="@font/demi_bold"
                    android:backgroundTint="#ffffff"
                    app:buttonBllocStyle="outline"
                    app:textColor_DARK="@color/white"
                    app:textColor_FOCUS="@color/white"
                    app:textColor_LIGHT="@color/white"
                    app:textColor_SUN="@color/gray_50"/>
            </LinearLayout>
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                android:textSize="16dp"
                android:textColor="@color/gray_20"
                android:id="@+id/focus_hour_end_time_selected_tv"
                android:paddingTop="5dp"
                android:paddingBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                app:textColor_DARK="@color/settingTextSecondary_dark"
                app:textColor_FOCUS="@color/settingTextSecondary_focus"
                app:textColor_LIGHT="@color/settingTextSecondary_light"
                app:textColor_SUN="@color/settingTextSecondary_sun"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                    android:id="@+id/add_focus_hour_exit_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonIsFilled="false"
                    app:buttonText="Cancel"
                    app:buttonType="Cancel"/>
                <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                    android:id="@+id/add_focus_hour_save_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonIsFilled="true"
                    app:buttonText="Add"
                    app:buttonType="Add"/>
            </LinearLayout>
        </LinearLayout>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
