<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/settings_item_paddingV">
    <com.blloc.uicomponents.old.customviews.ThemeableImageView
        android:id="@+id/setting_telegram_icon"
        android:layout_width="@dimen/settings_item_iconHeight"
        android:layout_height="@dimen/settings_item_iconHeight"
        android:layout_marginRight="@dimen/settings_item_icon_marginR"
        android:src="@drawable/icon_settings_telegram"
        app:imageColor_DARK="@color/white"
        app:imageColor_FOCUS="@color/white"
        app:imageColor_LIGHT="@color/white"
        app:imageColor_SUN="@color/gray_50"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingRight="@dimen/settings_item_icon_marginR"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/settings_item_textSize"
            android:gravity="center_vertical"
            android:id="@+id/setting_telegram_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.settings.services.telegram"
            android:fontFamily="@font/medium"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_50"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/settings_item_descriptionSize"
            android:gravity="center_vertical"
            android:id="@+id/setting_telegram_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medium"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_50"/>
        <EditText
            android:textColor="#323232"
            android:gravity="center_vertical"
            android:id="@+id/setting_telegram_input"
            android:background="@drawable/rounded_corners_50dp_fill"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="phone"
            android:fontFamily="@font/demi_bold"
            android:backgroundTint="#cdcdcd"
            android:paddingHorizontal="15dp"
            android:paddingVertical="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingRight="@dimen/settings_item_icon_marginR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.blloc.uicomponents.buttons.BllocButton
            android:id="@+id/setting_telegram_action_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
            app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
            app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
            app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
            app:button_isFilled="false"
            app:button_text="@string/common.button.login"
            app:button_textColor_DARK="@color/button_textColor_dark"
            app:button_textColor_FOCUS="@color/button_textColor_focus"
            app:button_textColor_LIGHT="@color/button_textColor_light"
            app:button_textColor_SUN="@color/button_textColor_sun"/>
        <com.blloc.uicomponents.buttons.BllocButton
            android:id="@+id/setting_telegram_reset_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
            app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
            app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
            app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
            app:button_isFilled="false"
            app:button_text="@string/common.button.reset"
            app:button_textColor_DARK="@color/button_textColor_dark"
            app:button_textColor_FOCUS="@color/button_textColor_focus"
            app:button_textColor_LIGHT="@color/button_textColor_light"
            app:button_textColor_SUN="@color/button_textColor_sun"/>
    </LinearLayout>
    <com.blloc.uicomponents.old.BllocSwitch
        android:id="@+id/setting_telegram_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:checked="false"/>
</LinearLayout>
