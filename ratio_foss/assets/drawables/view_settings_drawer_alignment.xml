<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottomsheet_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/bottomsheet_extra_padding_horizontal">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/bottom_sheet_title"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/bottom_sheet_title"
            android:paddingLeft="@dimen/setting_item_padding_horizontal"
            android:paddingBottom="@dimen/bottomsheet_title_padding_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings.drawer_alignment.settinglabel"
            android:fontFamily="@font/heavy"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/setting_item_text"
            android:gravity="center_vertical"
            android:id="@+id/vertical_alignment_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_vertical"
            android:fontFamily="@font/bold"
            android:paddingHorizontal="@dimen/setting_item_padding_horizontal"
            android:paddingVertical="@dimen/setting_item_padding_vertical"
            app:textColor_DARK="@color/standard_text_dark"
            app:textColor_FOCUS="@color/standard_text_focus"
            app:textColor_LIGHT="@color/standard_text_light"
            app:textColor_SUN="@color/standard_text_sun"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vertical_alignment_options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.blloc.uicomponents.view.SettingItemRadio
                android:id="@+id/vertical_align_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:settingItem_icon="@drawable/icon_aligntop"
                app:settingItem_text="@string/common_top"/>
            <com.blloc.uicomponents.view.SettingItemRadio
                android:id="@+id/vertical_align_center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:settingItem_icon="@drawable/icon_centervertical"
                app:settingItem_text="@string/common_center"/>
            <com.blloc.uicomponents.view.SettingItemRadio
                android:id="@+id/vertical_align_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:settingItem_icon="@drawable/icon_alignbottom"
                app:settingItem_text="@string/common_bottom"/>
        </LinearLayout>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/setting_item_text"
            android:gravity="center_vertical"
            android:id="@+id/horizontal_alignment_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_horizontal"
            android:fontFamily="@font/bold"
            android:paddingHorizontal="@dimen/setting_item_padding_horizontal"
            android:paddingVertical="@dimen/setting_item_padding_vertical"
            app:textColor_DARK="@color/standard_text_dark"
            app:textColor_FOCUS="@color/standard_text_focus"
            app:textColor_LIGHT="@color/standard_text_light"
            app:textColor_SUN="@color/standard_text_sun"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/horizontal_alignment_options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.blloc.uicomponents.view.SettingItemRadio
                android:id="@+id/horizontal_align_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:settingItem_icon="@drawable/icon_alignleft"
                app:settingItem_text="@string/common_left"/>
            <com.blloc.uicomponents.view.SettingItemRadio
                android:id="@+id/horizontal_align_center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:settingItem_icon="@drawable/icon_centerhorizontal"
                app:settingItem_text="@string/common_center"/>
        </LinearLayout>
    </LinearLayout>
</merge>
