<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/setting_row_min_height"
        android:animateLayoutChanges="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableImageView
                android:gravity="center_vertical"
                android:id="@+id/icon"
                android:layout_width="@dimen/setting_row_icon_size"
                android:layout_height="@dimen/setting_row_icon_size"
                android:layout_marginRight="@dimen/setting_row_icon_margin_right"
                android:src="@drawable/icon_settings_autoreply"
                app:imageColor_DARK="@color/white"
                app:imageColor_FOCUS="@color/white"
                app:imageColor_LIGHT="@color/white"
                app:imageColor_SUN="@color/gray_50"/>
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                android:textSize="15dp"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:paddingRight="20dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/tree.settings.general.auto_reply"
                android:layout_weight="1"
                android:fontFamily="@font/medium"
                app:textColor_DARK="@color/white"
                app:textColor_FOCUS="@color/white"
                app:textColor_LIGHT="@color/white"
                app:textColor_SUN="@color/gray_50"/>
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBllocButton
                android:textSize="12dp"
                android:textColor="@color/gray_1"
                android:gravity="center"
                android:id="@+id/show_btn"
                android:background="@drawable/rounded_corners_50dp_fill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="@string/common.button.show"
                android:fontFamily="@font/medium"
                android:backgroundTint="#ffffff"
                app:buttonBllocStyle="outline"
                app:textColor_DARK="@color/white"
                app:textColor_FOCUS="@color/white"
                app:textColor_LIGHT="@color/white"
                app:textColor_SUN="@color/gray_50"/>
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBllocButton
                android:textSize="12dp"
                android:textColor="@color/gray_1"
                android:gravity="center"
                android:id="@+id/add_btn"
                android:background="@drawable/rounded_corners_50dp_fill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common.button.add"
                android:fontFamily="@font/medium"
                android:backgroundTint="#ffffff"
                app:buttonBllocStyle="outline"
                app:textColor_DARK="@color/white"
                app:textColor_FOCUS="@color/white"
                app:textColor_LIGHT="@color/white"
                app:textColor_SUN="@color/gray_50"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/empty_layout_divider"
            android:animateLayoutChanges="true"
            android:showDividers="middle"/>
    </LinearLayout>
</merge>
