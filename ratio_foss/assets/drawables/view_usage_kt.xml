<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/usage_access_disabled"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="30dp">
        <TextView
            android:textSize="@dimen/bottom_sheet_description"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/usage_access_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tiles.edit_app.usage.disabled"
            android:fontFamily="@font/medium"/>
        <com.blloc.uicomponents.buttons.BllocButton
            android:id="@+id/usage_access_button"
            android:paddingTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
            app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
            app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
            app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
            app:button_isFilled="true"
            app:button_text="@string/tiles.edit_app.usage.disabled.button"
            app:button_textColor_DARK="@color/button_textColor_dark"
            app:button_textColor_FOCUS="@color/button_textColor_focus"
            app:button_textColor_LIGHT="@color/button_textColor_light"
            app:button_textColor_SUN="@color/button_textColor_sun"
            app:button_textSize="@dimen/bottom_sheet_button_text"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_usage"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:id="@+id/usage_time_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tiles.edit_app.usage"
                android:fontFamily="@font/heavy"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#ffffff"
                android:gravity="bottom"
                android:id="@+id/max_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text=""
                android:layout_alignParentRight="true"
                android:fontFamily="@font/heavy"/>
        </LinearLayout>
        <Button
            android:textColor="@color/white"
            android:id="@+id/test_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="test"
            android:alpha="0"
            android:fontFamily="@font/heavy"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bars_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:animateLayoutChanges="false"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/times_container"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_alignParentBottom="true"
            android:animateLayoutChanges="false"/>
        <RelativeLayout
            android:id="@+id/time_selector"
            android:background="@drawable/view_usage_time_selector_background_new_theme_light"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="250dp"
            android:layout_height="25dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <View
                android:id="@+id/time_selector_background"
                android:background="@drawable/view_usage_time_selector_item_selected_background_new_dark"
                android:layout_width="125dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#555555"
                android:gravity="center"
                android:id="@+id/time_selector_today"
                android:layout_width="125dp"
                android:layout_height="match_parent"
                android:text="Today"
                android:fontFamily="@font/heavy"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#444444"
                android:gravity="center"
                android:id="@+id/time_selector_week"
                android:layout_width="125dp"
                android:layout_height="match_parent"
                android:text="Last week"
                android:layout_alignParentRight="true"
                android:fontFamily="@font/heavy"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/selector_switch_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/tiles.edit_app.usage.today"
                android:fontFamily="@font/bold"
                android:paddingHorizontal="20dp"/>
            <com.blloc.uicomponents.old.BllocSwitch
                android:id="@+id/selector_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checked="false"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
