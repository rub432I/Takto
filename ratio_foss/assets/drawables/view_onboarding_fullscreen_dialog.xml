<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:paddingTop="50dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="50dp">
    <com.blloc.bllocjavatiles.custom_views.StaticViewPager
        android:layout_gravity="center_horizontal"
        android:id="@+id/view_pager"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:paddingHorizontal="120dp">
        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:paddingHorizontal="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/onboarding_phone_empty"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animation_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                app:lottie_rawRes="@raw/onboarding_welcome_drawers"/>
        </FrameLayout>
    </com.blloc.bllocjavatiles.custom_views.StaticViewPager>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5">
        <TextView
            android:textSize="30dp"
            android:textColor="#343434"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tiles.onboarding.title"
            android:fontFamily="@font/heavy"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#343434"
            android:gravity="center_horizontal"
            android:id="@+id/app_description_tv"
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tiles.onboarding.app_description"
            android:fontFamily="@font/bold"
            android:paddingHorizontal="80dp"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/onboarding_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/skip_btn"
                android:background="@drawable/tile_shortcut_pill_background_black_outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:backgroundTint="#000000"
                android:layout_marginHorizontal="5dp">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="7dp"
                    android:src="@drawable/ic_onboarding_btn_skip"
                    android:tint="#000000"
                    android:paddingVertical="10dp"/>
                <TextView
                    android:textColor="#000000"
                    android:gravity="center_vertical"
                    android:paddingRight="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common.button.skip"
                    android:fontFamily="@font/bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="5dp"
                    android:paddingVertical="7dp"
                    android:autoSizeMaxTextSize="12dp"/>
            </LinearLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/start_tour_btn"
                android:background="@drawable/rounded_corners_50dp_fill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:backgroundTint="#343434"
                android:layout_marginHorizontal="5dp">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="7dp"
                    android:src="@drawable/ic_onboarding_btn_next"
                    android:paddingVertical="10dp"/>
                <TextView
                    android:textColor="#e2ff00"
                    android:gravity="center_vertical"
                    android:paddingRight="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common.button.start"
                    android:fontFamily="@font/bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="5dp"
                    android:paddingVertical="7dp"
                    android:autoSizeMaxTextSize="12dp"/>
            </LinearLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
