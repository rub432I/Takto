<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/edit_tag_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
        android:gravity="center"
        android:id="@+id/edit_tag_icon_container"
        android:layout_width="@dimen/user_settings_tag_icon"
        android:layout_height="@dimen/user_settings_tag_icon"
        android:layout_marginRight="@dimen/user_settings_tag_icon_margin"
        app:linearBackground_DARK="#323232"
        app:linearBackground_FOCUS="#323232"
        app:linearBackground_LIGHT="#d9d9d9"
        app:linearBackground_SUN="#d9d9d9"
        app:linearLayout_corner_radius="@dimen/conversation_options_item_corners">
        <com.vanniktech.emoji.EmojiEditText
            android:textSize="18dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/emojiEditText"
            android:background="@null"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="������"
            android:cursorVisible="false"
            android:maxLines="1"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend"
            android:textIsSelectable="false"/>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
        android:gravity="center"
        android:layout_gravity="left"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        app:linearBackground_DARK="#323232"
        app:linearBackground_FOCUS="#323232"
        app:linearBackground_LIGHT="#d9d9d9"
        app:linearBackground_SUN="#d9d9d9"
        app:linearLayout_corner_radius="@dimen/conversation_options_item_corners">
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableEditText
            android:textSize="@dimen/user_settings_tag_text"
            android:gravity="left"
            android:id="@+id/edit_tag_label"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxLength="10"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:fontFamily="@font/bold"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="#797979"
            app:textColor_SUN="#797979"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableImageView
            android:id="@+id/add_tag_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_usersettings__addtag_plus"
            app:imageColor_DARK="@color/white"
            app:imageColor_FOCUS="@color/white"
            app:imageColor_LIGHT="#636363"
            app:imageColor_SUN="#636363"/>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
</LinearLayout>
