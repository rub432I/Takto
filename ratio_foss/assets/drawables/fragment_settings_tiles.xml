<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/settings_padding_horizontal">
    <com.blloc.uicomponents.view.SettingItem
        android:id="@+id/setting_item_backup_configuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_tiles_backup"
        app:settingItem_text="@string/settings.tiles_configuration.settinglabel"/>
    <com.blloc.uicomponents.view.SettingItem
        android:id="@+id/setting_item_autocategorize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_tiles_autocategorize"
        app:settingItem_text="@string/settings.auto_categorize_apps.settinglabel"/>
    <com.blloc.uicomponents.view.SettingItem
        android:id="@+id/setting_item_drawers_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_tiles_drawericons"
        app:settingItem_text="@string/settings.drawers.settinglabel"/>
    <com.blloc.uicomponents.view.SettingItemSwitch
        android:id="@+id/setting_item_permanent_notifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_tiles_notifications"
        app:settingItem_text="@string/settings.hide_permanent_notifications.settinglabel"/>
    <com.blloc.uicomponents.view.SettingItemSwitch
        android:id="@+id/setting_item_pinned_root_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_tiles_pinnedcards"
        app:settingItem_text="@string/settings.show_pinned_root_cards.settinglabel"/>
    <com.blloc.uicomponents.view.SettingItemSwitch
        android:id="@+id/setting_item_pull_down"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_tiles_pulldown"
        app:settingItem_text="@string/settings.pulldown_to_open_controlpanel.settinglabel"/>
    <com.blloc.uicomponents.view.SettingItemSwitch
        android:id="@+id/setting_item_double_tap_lock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_tiles_lock"
        app:settingItem_text="@string/settings.double_tap_background_to_lock.settinglabel"/>
    <com.blloc.uicomponents.view.SettingItem
        android:id="@+id/setting_item_icon_pack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_tiles_iconpacks"
        app:settingItem_text="@string/settings.icon_pack.settinglabel"/>
    <com.blloc.uicomponents.view.SettingItem
        android:id="@+id/setting_item_hidden_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_tiles_hiddenapps"
        app:settingItem_text="@string/settings.hidden_apps.settinglabel"/>
</LinearLayout>
