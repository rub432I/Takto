<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/conversation_options_scroll"
    android:background="@color/transparent"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="left"
        android:orientation="horizontal"
        android:id="@+id/conversation_options_menu"
        android:background="@color/transparent"
        android:paddingLeft="15dp"
        android:paddingTop="@dimen/conversation_options_offset"
        android:paddingRight="@dimen/conversation_options_hPadding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.blloc.bllocjavatree.ui.utils.MultiUseOption
            android:id="@+id/option_mark_as_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:optionImage="@drawable/ic_option_markasread"
            app:optionText="Mark as read"/>
        <com.blloc.bllocjavatree.ui.utils.MultiUseOption
            android:id="@+id/option_rename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:optionImage="@drawable/ic_option_rename"
            app:optionText="Rename"/>
        <com.blloc.bllocjavatree.ui.utils.MultiUseOption
            android:id="@+id/option_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:optionImage="@drawable/ic_option_tag"
            app:optionText="Tags"/>
        <com.blloc.bllocjavatree.ui.utils.MultiUseOption
            android:id="@+id/option_mute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:optionImage="@drawable/ic_option_mute"
            app:optionText="Mute"/>
        <com.blloc.bllocjavatree.ui.utils.MultiUseOption
            android:id="@+id/option_merge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:optionImage="@drawable/ic_option_merge"
            app:optionText="Merge"/>
        <com.blloc.bllocjavatree.ui.utils.MultiUseOption
            android:id="@+id/option_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:optionImage="@drawable/ic_option_pin"
            app:optionText="Pin"/>
        <com.blloc.bllocjavatree.ui.utils.MultiUseOption
            android:id="@+id/option_archive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:optionImage="@drawable/ic_option_archive"
            app:optionText="Archive"/>
        <com.blloc.bllocjavatree.ui.utils.MultiUseOption
            android:id="@+id/option_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:optionImage="@drawable/ic_option_delete"
            app:optionText="Remove"/>
    </LinearLayout>
</HorizontalScrollView>
