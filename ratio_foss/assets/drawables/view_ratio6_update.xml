<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottomsheet_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/bottomsheet_extra_padding_horizontal">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/bottom_sheet_title"
            android:gravity="center"
            android:id="@+id/bottom_sheet_title"
            android:paddingBottom="@dimen/bottom_sheet_item_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ratio 6"
            android:fontFamily="@font/heavy"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/update_item_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/updates_ratio6_notifications_description"
            app:settingItem_icon="@drawable/icon_ratio_notifications"
            app:settingItem_text="@string/updates_ratio6_notifications_title"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/update_item_conversations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/updates_ratio6_conversations_description"
            app:settingItem_icon="@drawable/conversations_settings_icon"
            app:settingItem_text="@string/updates_ratio6_conversations_title"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/update_item_icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/updates_ratio6_icons_description"
            app:settingItem_icon="@drawable/settings_icon_tiles_iconpacks"
            app:settingItem_text="@string/updates_ratio6_icons_title"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/update_item_uiux"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/updates_ratio6_uiux_description"
            app:settingItem_icon="@drawable/tiles_seetings_icon"
            app:settingItem_text="@string/updates_ratio6_uiux_title"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/update_item_visualdesign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/updates_ratio6_visualdesign_description"
            app:settingItem_icon="@drawable/settings_icon_general_wallpapers"
            app:settingItem_text="@string/updates_ratio6_visualdesign_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/setting_item_padding_horizontal"
            android:layout_marginVertical="20dp">
            <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/learn_more"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginBottom="20dp"
                app:linearBackground_DARK="@color/button_backgroundColor_dark"
                app:linearBackground_FOCUS="@color/button_backgroundColor_focus"
                app:linearBackground_LIGHT="@color/button_backgroundColor_light"
                app:linearBackground_SUN="@color/button_backgroundColor_sun"
                app:linearLayout_corner_radius="50dp">
                <com.blloc.uicomponents.old.customviews.ThemeableTextView
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_learn_more"
                    android:fontFamily="@font/bold"
                    app:textColor_DARK="@color/button_textColor_dark"
                    app:textColor_FOCUS="@color/button_textColor_focus"
                    app:textColor_LIGHT="@color/button_textColor_light"
                    app:textColor_SUN="@color/button_textColor_sun"/>
            </com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:gravity="center"
                android:id="@+id/dismiss"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/common.button.dismiss"
                app:textColor_DARK="@color/bottom_sheet_text_dark"
                app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                app:textColor_LIGHT="@color/bottom_sheet_text_light"
                app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        </LinearLayout>
    </LinearLayout>
</merge>
