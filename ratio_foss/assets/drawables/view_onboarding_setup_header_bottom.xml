<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/onboarding_header_paddingH"
    android:paddingVertical="@dimen/onboarding_header_paddingV">
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="@dimen/onboarding_title_size"
        android:gravity="center"
        android:id="@+id/header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding.dock.title"
        android:fontFamily="@font/heavy"
        app:textColor_DARK="@color/onboarding_text_dark"
        app:textColor_FOCUS="@color/onboarding_text_dark"
        app:textColor_LIGHT="@color/onboarding_text_light"
        app:textColor_SUN="@color/onboarding_text_light"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="@dimen/onboarding_description_size"
        android:gravity="center"
        android:id="@+id/header_description"
        android:paddingTop="@dimen/onboarding_description_paddingT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding.dock.description"
        android:fontFamily="@font/medium"
        app:textColor_DARK="@color/onboarding_text_dark"
        app:textColor_FOCUS="@color/onboarding_text_dark"
        app:textColor_LIGHT="@color/onboarding_text_light"
        app:textColor_SUN="@color/onboarding_text_light"/>
    <com.blloc.uicomponents.buttons.BllocButton
        android:id="@+id/header_button"
        android:paddingTop="@dimen/onboarding_button_paddingT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
        app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
        app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
        app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
        app:button_isFilled="true"
        app:button_text="@string/onboarding.default.button"
        app:button_textColor_DARK="@color/button_textColor_dark"
        app:button_textColor_FOCUS="@color/button_textColor_focus"
        app:button_textColor_LIGHT="@color/button_textColor_light"
        app:button_textColor_SUN="@color/button_textColor_sun"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/wallpaper_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.blloc.uicomponents.view.BllocSlideSelectorWithAccentColor
            android:id="@+id/slideSelector"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:paddingHorizontal="@dimen/settings_item_paddingH"
            app:option1Text="@string/onboarding.wallpaper.optionDark"
            app:option2Text="@string/onboarding.wallpaper.optionLight"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/onboarding_description_size"
            android:id="@+id/wallpaper_button_keep"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/onboarding.wallpaper.optionKeep"
            android:fontFamily="@font/medium"
            app:textColor_DARK="@color/onboarding_text_dark"
            app:textColor_FOCUS="@color/onboarding_text_dark"
            app:textColor_LIGHT="@color/onboarding_text_light"
            app:textColor_SUN="@color/onboarding_text_light"/>
    </LinearLayout>
    <com.blloc.uicomponents.old.customviews.ThemeableLottieAnimationView2
        android:id="@+id/header_bottom_lottie"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        app:lottieColorBase_DARK="@color/bottom_sheet_lottie_dark"
        app:lottieColorBase_FOCUS="@color/bottom_sheet_lottie_focus"
        app:lottieColorBase_LIGHT="@color/bottom_sheet_lottie_sun"
        app:lottieColorBase_SUN="@color/bottom_sheet_lottie_sun"
        app:lottieColor_DARK="@color/white"
        app:lottieColor_FOCUS="@color/white"
        app:lottieColor_LIGHT="@color/gray_70"
        app:lottieColor_SUN="@color/gray_70"/>
</LinearLayout>
