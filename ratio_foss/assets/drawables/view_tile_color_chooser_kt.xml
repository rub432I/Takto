<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.kotlintiles.ui.appeditscreen.custom_views.FadingEdgeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:fel_edge="bottom|top"
        app:fel_size_bottom="20dp"
        app:fel_size_top="20dp">
        <com.blloc.kotlintiles.ui.appeditscreen.utils.VerticalStaticViewPager
            android:id="@+id/tile_color_vp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/tile_color_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:fontFamily="@font/bold"/>
    </com.blloc.kotlintiles.ui.appeditscreen.custom_views.FadingEdgeLayout>
</FrameLayout>
