<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
        android:orientation="horizontal"
        android:id="@+id/quoted_view_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cornerRadius="@dimen/conversation_header_corner_radius"
        app:linearBackground_DARK="@color/reply_view_background_dark"
        app:linearBackground_FOCUS="@color/reply_view_background_focus"
        app:linearBackground_LIGHT="@color/reply_view_background_light"
        app:linearBackground_SUN="@color/reply_view_background_sun">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/background_replay_view_border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_marginRight="30dp"
            android:layout_weight="1"
            android:paddingHorizontal="5dp"
            android:paddingVertical="5dp">
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/quoted_sender"
                android:paddingBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"/>
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/quoted_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/quoted_sender"
                android:fontFamily="@font/oblique_demi_bold"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/close_btn"
            android:padding="7dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_close_quoted_message"
            android:layout_alignParentRight="true"/>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
</merge>
