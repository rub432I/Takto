<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/conversation_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBlurView
        android:id="@+id/conversation_blurview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cornerRadius="0dp"
        app:foregroundColor_DARK="@color/transparent"
        app:foregroundColor_FOCUS="@color/opacity_100"
        app:foregroundColor_LIGHT="@color/transparent"
        app:foregroundColor_SUN="@color/white">
        <FrameLayout
            android:id="@+id/conversation_content"
            android:clipChildren="false"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.blloc.bllocjavatree.ui.sections.conversation.horizontalswipe.ConversationListRecyclerview
                android:id="@+id/conversation_list"
                android:paddingTop="60dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:layout_gravity="bottom"
                android:id="@+id/reply_view_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:paddingHorizontal="3dp"
                android:paddingVertical="5dp">
                <com.blloc.bllocjavatree.ui.sections.conversation.replyutils.ReplyView
                    android:id="@+id/reply_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cornerRadius="@dimen/quote_corner_radius"/>
            </LinearLayout>
        </FrameLayout>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBlurView>
    <RelativeLayout
        android:gravity="top"
        android:id="@+id/conversation_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:animateLayoutChanges="true"
        android:layout_marginVertical="@dimen/user_settings_item_margin">
        <com.blloc.uicomponents.old.customviews.ThemeableBlurView
            android:id="@+id/conversation_header_background"
            android:tag="tessst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:blurDisabledColor_DARK="@color/gray_80"
            app:blurDisabledColor_LIGHT="@color/gray_70"
            app:cornerRadius="@dimen/conversation_header_corner_radius"
            app:foregroundColor_DARK="@color/transparent"
            app:foregroundColor_FOCUS="@color/transparent"
            app:foregroundColor_LIGHT="@color/transparent"
            app:foregroundColor_SUN="@color/transparent">
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/conversation_header"
                android:background="@drawable/background_corners_med"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:animateLayoutChanges="true"
                android:paddingVertical="10dp"
                app:linearBackground_DARK="@color/conversationHeader_dark"
                app:linearBackground_FOCUS="@color/conversationHeader_focus"
                app:linearBackground_LIGHT="@color/conversationHeader_light"
                app:linearBackground_SUN="@color/conversationHeader_sun">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableImageView
                    android:id="@+id/conversation_back"
                    android:layout_width="@dimen/conversation_header_back"
                    android:layout_height="@dimen/conversation_header_back"
                    android:src="@drawable/ic_conversation_back"
                    android:paddingHorizontal="19dp"
                    android:paddingVertical="5dp"
                    app:imageColor_DARK="@color/icon_dark"
                    app:imageColor_FOCUS="@color/icon_focus"
                    app:imageColor_LIGHT="@color/icon_light"
                    app:imageColor_SUN="@color/icon_sun"/>
                <ImageView
                    android:id="@+id/conversation_image"
                    android:layout_width="@dimen/conversation_header_image_height_collapsed"
                    android:layout_height="@dimen/conversation_header_image_height_collapsed"
                    android:src="@drawable/ic_conversation_placeholder"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:animateLayoutChanges="true"
                    android:paddingVertical="10dp">
                    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                        android:textSize="17dp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/conversation_display_name"
                        android:paddingLeft="@dimen/conversation_header_image_margin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:fontFamily="@font/bold"
                        android:breakStrategy="simple"
                        android:paddingVertical="5dp"
                        app:textColor_DARK="@color/displayName_dark"
                        app:textColor_FOCUS="@color/displayName_focus"
                        app:textColor_LIGHT="@color/displayName_light"
                        app:textColor_SUN="@color/displayName_sun"/>
                    <com.blloc.bllocjavatree.ui.sections.conversation.settings.PhoneNumberView
                        android:id="@+id/phone_number_view"
                        android:paddingLeft="@dimen/conversation_header_image_margin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/messaging_services_container"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
        </com.blloc.uicomponents.old.customviews.ThemeableBlurView>
    </RelativeLayout>
    <com.blloc.bllocjavatree.ui.sections.mainscreen.allconversations.utils.FadingEdgeLayout
        android:id="@+id/user_settings_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/user_settings_close"
        android:layout_below="@+id/conversation_header_container"
        android:animateLayoutChanges="true"
        app:fel_edge="bottom"
        app:fel_size_bottom="30dp">
        <ScrollView
            android:id="@+id/user_settings_view_scrollview"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:animateLayoutChanges="true">
            <com.blloc.bllocjavatree.ui.sections.conversation.settings.UserSettingsView
                android:id="@+id/user_settings_view"
                android:paddingBottom="50dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </com.blloc.bllocjavatree.ui.sections.mainscreen.allconversations.utils.FadingEdgeLayout>
    <LinearLayout
        android:id="@+id/user_settings_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginVertical="@dimen/input_bar_margin">
        <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/user_settings_close_btn"
            android:padding="9dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:linearBackground_DARK="@color/gray_70"
            app:linearBackground_FOCUS="@color/gray_80"
            app:linearBackground_LIGHT="@color/gray_40"
            app:linearBackground_SUN="@color/gray_20"
            app:linearLayout_corner_radius="25dp">
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/settings_close_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common.button.close"
                android:fontFamily="@font/bold"
                app:textColor_DARK="@color/white"
                app:textColor_FOCUS="@color/white"
                app:textColor_LIGHT="@color/white"
                app:textColor_SUN="@color/gray_50"/>
        </com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
    </LinearLayout>
</RelativeLayout>
