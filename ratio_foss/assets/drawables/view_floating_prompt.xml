<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|center_vertical"
    android:id="@+id/item_root"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/floating_prompt_paddingH"
    style="@style/SelectableItemBackground">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:orientation="horizontal"
            android:id="@+id/item_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:paddingVertical="@dimen/floating_prompt_paddingV">
            <com.blloc.uicomponents.old.customviews.ThemeableImageView
                android:layout_gravity="left"
                android:id="@+id/item_icon_remove_left"
                android:layout_width="@dimen/floating_prompt_iconSize"
                android:layout_height="@dimen/floating_prompt_iconSize"
                android:src="@drawable/ic_remove"
                android:alpha="0"
                app:imageColor_DARK="@color/floating_prompt_text_DARK"
                app:imageColor_FOCUS="@color/floating_prompt_text_FOCUS"
                app:imageColor_LIGHT="@color/floating_prompt_text_LIGHT"
                app:imageColor_SUN="@color/floating_prompt_text_SUN"/>
            <com.blloc.uicomponents.old.customviews.ThemeableImageView
                android:layout_gravity="right"
                android:id="@+id/item_icon_remove_right"
                android:layout_width="@dimen/floating_prompt_iconSize"
                android:layout_height="@dimen/floating_prompt_iconSize"
                android:src="@drawable/ic_remove"
                android:alpha="0"
                app:imageColor_DARK="@color/floating_prompt_text_DARK"
                app:imageColor_FOCUS="@color/floating_prompt_text_FOCUS"
                app:imageColor_LIGHT="@color/floating_prompt_text_LIGHT"
                app:imageColor_SUN="@color/floating_prompt_text_SUN"/>
        </FrameLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_foreground"
        android:background="@color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:paddingVertical="@dimen/floating_prompt_paddingV">
        <com.blloc.uicomponents.old.customviews.ThemeableImageView
            android:id="@+id/item_foreground_icon"
            android:layout_width="@dimen/floating_prompt_iconSize"
            android:layout_height="@dimen/floating_prompt_iconSize"
            android:layout_marginRight="@dimen/floating_prompt_paddingH"
            android:src="@drawable/ic_placeholder"
            app:imageColor_DARK="@color/floating_prompt_text_DARK"
            app:imageColor_FOCUS="@color/floating_prompt_text_FOCUS"
            app:imageColor_LIGHT="@color/floating_prompt_text_LIGHT"
            app:imageColor_SUN="@color/floating_prompt_text_SUN"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/floating_prompt_margin"
            android:layout_weight="1">
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/floating_prompt_text"
                android:gravity="center_vertical"
                android:id="@+id/item_foreground_text"
                android:paddingRight="@dimen/floating_prompt_paddingH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                app:textColor_DARK="@color/floating_prompt_text_DARK"
                app:textColor_FOCUS="@color/floating_prompt_text_FOCUS"
                app:textColor_LIGHT="@color/floating_prompt_text_LIGHT"
                app:textColor_SUN="@color/floating_prompt_text_SUN"/>
        </LinearLayout>
    </LinearLayout>
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:id="@+id/item_separator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/floating_prompt_separatorHeight"
        android:layout_alignTop="@+id/item_root"
        app:linearBackground_DARK="@color/floating_prompt_separator_DARK"
        app:linearBackground_FOCUS="@color/floating_prompt_separator_FOCUS"
        app:linearBackground_LIGHT="@color/floating_prompt_separator_LIGHT"
        app:linearBackground_SUN="@color/floating_prompt_separator_SUN"
        app:linearLayout_corner_radius="@dimen/bottom_sheet_handle_corners"/>
</FrameLayout>
