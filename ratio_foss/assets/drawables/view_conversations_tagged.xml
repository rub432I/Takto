<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/tagged_conversations_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tagged_conversations_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/grouped_header_margin_top"
        android:layout_marginBottom="@dimen/grouped_header_margin_bottom"
        android:paddingHorizontal="@dimen/grouped_header_padding_horizontal">
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
            android:gravity="center"
            android:id="@+id/tag_icon_container"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginRight="10dp"
            app:linearBackground_DARK="@color/blloc_yellow"
            app:linearBackground_FOCUS="@color/blloc_yellow"
            app:linearBackground_LIGHT="@color/blloc_yellow"
            app:linearBackground_SUN="@color/actionBackground_sun"
            app:linearLayout_corner_radius="50dp">
            <com.vanniktech.emoji.EmojiEditText
                android:textSize="17dp"
                android:gravity="center"
                android:id="@+id/tagged_conversations_icon"
                android:background="@null"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="������"
                android:cursorVisible="false"
                android:maxLines="1"
                android:inputType="textMultiLine"
                android:imeOptions="actionSend"
                android:textIsSelectable="false"/>
        </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                android:textSize="@dimen/main_title_font_size"
                android:textColor="@color/blloc_yellow"
                android:gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="#"
                android:fontFamily="@font/bold"
                app:textColor_DARK="@color/title_tags_dark"
                app:textColor_FOCUS="@color/title_tags_focus"
                app:textColor_LIGHT="@color/title_tags_light"
                app:textColor_SUN="@color/title_tags_sun"/>
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableEditableTextView
                android:textSize="@dimen/main_title_font_size"
                android:textColor="@color/blloc_yellow"
                android:ellipsize="end"
                android:id="@+id/tagged_conversations_title"
                android:background="@color/transparent"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="30dp"
                android:text="Tag name"
                android:cursorVisible="true"
                android:maxLength="16"
                android:layout_alignParentLeft="true"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@null"
                android:fontFamily="@font/bold"
                app:textColor_DARK="@color/title_tags_dark"
                app:textColor_FOCUS="@color/title_tags_focus"
                app:textColor_LIGHT="@color/title_tags_light"
                app:textColor_SUN="@color/title_tags_sun"/>
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
                android:orientation="horizontal"
                android:id="@+id/tag_name_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="1dp"
                app:linearBackground_DARK="@color/blloc_yellow"
                app:linearBackground_FOCUS="@color/blloc_yellow"
                app:linearBackground_LIGHT="@color/blloc_yellow"
                app:linearBackground_SUN="@color/gray_70"
                app:linearLayout_corner_radius="50dp">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                    android:textSize="14dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common.button.save"
                    android:fontFamily="@font/bold"
                    app:textColor_DARK="@color/tag_text_dark"
                    app:textColor_FOCUS="@color/tag_text_focus"
                    app:textColor_LIGHT="@color/tag_text_light"
                    app:textColor_SUN="@color/white"/>
            </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
        </LinearLayout>
    </LinearLayout>
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
        android:textSize="15sp"
        android:textColor="#fff"
        android:gravity="end"
        android:id="@+id/tagged_found"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="0"
        android:fontFamily="@font/medium"
        android:layout_marginStart="15dp"
        android:elevation="2dp"
        app:textColor_DARK="@color/subtitle_dark"
        app:textColor_FOCUS="@color/subtitle_focus"
        app:textColor_LIGHT="@color/subtitle_light"
        app:textColor_SUN="@color/subtitle_sun"/>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.blloc.bllocjavatree.ui.sections.mainscreen.taggedconversations.TaggedConversationsView
            android:orientation="vertical"
            android:id="@+id/tagged_conversations_list"
            android:paddingTop="@dimen/card_vertical_padding"
            android:paddingBottom="@dimen/card_vertical_padding"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:alpha="1"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="15sp"
            android:textColor="#fff"
            android:gravity="end"
            android:id="@+id/tagged_no_results"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.ui.misc.num_conversations_none.tag"
            android:layout_centerVertical="true"
            android:fontFamily="@font/medium"
            android:layout_marginStart="15dp"
            android:elevation="2dp"
            android:layout_marginVertical="15dp"
            app:textColor_DARK="@color/text_dark"
            app:textColor_FOCUS="@color/text_focus"
            app:textColor_LIGHT="@color/text_light"
            app:textColor_SUN="@color/text_sun"/>
    </RelativeLayout>
</LinearLayout>
