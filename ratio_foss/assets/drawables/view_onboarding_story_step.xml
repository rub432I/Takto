<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_story_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/onboarding_stories_paddingL"
        android:paddingTop="@dimen/onboarding_stories_paddingT"
        android:paddingRight="@dimen/onboarding_stories_paddingR"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/onboarding_stories_title"
            android:textColor="@color/white"
            android:id="@+id/story_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding.stories.title1"
            android:fontFamily="@font/heavy"/>
        <TextView
            android:textSize="@dimen/onboarding_stories_description"
            android:textColor="@color/white"
            android:id="@+id/story_description"
            android:paddingTop="@dimen/onboarding_stories_description_paddingT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding.stories.description1"
            android:fontFamily="@font/medium"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/reverse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:id="@+id/skip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/story_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.blloc.uicomponents.story.StoryProgressView
            android:layout_gravity="top"
            android:id="@+id/story"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="2dp"
            app:progressBackgroundColor="@color/story_background"
            app:progressColor="@color/story_progress"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/next_step_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/onboarding_navigation_marginB">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/story_get_started"
            android:background="@drawable/rounded_corners_50dp_fill"
            android:padding="@dimen/settings_version_padding"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:backgroundTint="@color/white"
            android:layout_marginHorizontal="@dimen/onboarding_navigation_paddingH">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/gray_70"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding.stories.button"
                android:fontFamily="@font/bold"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
