<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/background"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/view_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp"
        android:layout_centerHorizontal="true">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/fingerprint_view"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerInParent="true"
            app:lottie_colorFilter="#ffffffff"
            app:lottie_rawRes="@raw/android_fingerprint"/>
        <TextView
            android:textSize="25dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/label_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tiles.app_lock.locked"
            android:layout_below="@+id/fingerprint_view"
            android:translationY="-50dp"
            android:fontFamily="@font/heavy"/>
    </LinearLayout>
    <TextView
        android:textSize="20dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/message_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:text="@string/tiles.message.try_again"
        android:layout_alignParentBottom="true"
        android:fontFamily="@font/demi_bold"/>
</RelativeLayout>
