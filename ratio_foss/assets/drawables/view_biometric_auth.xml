<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/gradient_background_1"
        android:background="@drawable/gradient_onscreen_fingerprint_indicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/gradient_background_2"/>
    <View
        android:id="@+id/gradient_background_2"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_alignParentBottom="true"/>
    <View
        android:background="@drawable/rounded_corners_10dp_fill_new"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_margin="30dp"/>
    <TextView
        android:textColor="#000000"
        android:id="@+id/cancel_btn"
        android:background="@drawable/drawer_edit_menu_icon_background_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:text="Cancel"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:layout_marginHorizontal="5dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:autoSizeMaxTextSize="12dp"/>
    <TextView
        android:textSize="25dp"
        android:textColor="#ffffff"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:text="Cancel"
        android:layout_above="@+id/cancel_btn"
        android:layout_centerHorizontal="true"
        android:translationY="-50dp"
        android:fontFamily="@font/bold"
        android:autoSizeTextType="uniform"
        android:layout_marginHorizontal="5dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animation_view"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginBottom="20dp"
        android:layout_above="@+id/title_tv"
        android:layout_centerHorizontal="true"/>
</merge>
