<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:foregroundColor_DARK="@color/background_sec_dark"
        app:foregroundColor_FOCUS="@color/background_sec_focus"
        app:foregroundColor_LIGHT="@color/background_sec_light"
        app:foregroundColor_SUN="@color/messageBackground_self_sun">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="100dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_view"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:lottie_colorFilter="#ffffff"
                app:lottie_rawRes="@raw/lottie_tree_lock"/>
            <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/tree.ui.biometric_lock.text"
                android:fontFamily="@font/medium"
                app:textColor_DARK="#ffffff"
                app:textColor_FOCUS="#ffffff"
                app:textColor_LIGHT="#ffffff"
                app:textColor_SUN="#636363"/>
        </LinearLayout>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBlurView>
</LinearLayout>
