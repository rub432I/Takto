<?xml version="1.0" encoding="utf-8"?>
<com.blloc.uicomponents.old.customviews.ThemeableFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/onboarding_language_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    app:background_DARK="@color/onboarding_background_dark"
    app:background_FOCUS="@color/onboarding_background_dark"
    app:background_LIGHT="@color/onboarding_background_light"
    app:background_SUN="@color/onboarding_background_light">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/language_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/onboarding_header_paddingH"
            android:paddingVertical="@dimen/onboarding_header_paddingV">
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/onboarding_title_language"
                android:id="@+id/language_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding.language.title"
                android:fontFamily="@font/heavy"
                app:textColor_DARK="@color/onboarding_text_dark"
                app:textColor_FOCUS="@color/onboarding_text_dark"
                app:textColor_LIGHT="@color/onboarding_text_light"
                app:textColor_SUN="@color/onboarding_text_light"/>
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/onboarding_description_size"
                android:gravity="center"
                android:id="@+id/language_description"
                android:paddingTop="@dimen/onboarding_description_paddingT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding.language.description"
                android:fontFamily="@font/medium"
                app:textColor_DARK="@color/onboarding_text_dark"
                app:textColor_FOCUS="@color/onboarding_text_dark"
                app:textColor_LIGHT="@color/onboarding_text_light"
                app:textColor_SUN="@color/onboarding_text_light"/>
        </LinearLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/languages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="35dp"
            android:paddingVertical="5dp"
            app:alignContent="stretch"
            app:alignItems="center"
            app:flexWrap="wrap"
            app:justifyContent="center">
            <com.bllocosn.ui.onboarding.language.OnboardingLanguageItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bllocosn.ui.onboarding.language.OnboardingLanguageItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom|fill_horizontal"
        android:id="@+id/onboarding_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/onboarding_navigation_marginB"
        android:paddingHorizontal="@dimen/onboarding_navigation_paddingH">
        <LinearLayout
            android:layout_gravity="left"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.blloc.uicomponents.buttons.BllocButton
                android:id="@+id/onboarding_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
                app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
                app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
                app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
                app:button_isFilled="false"
                app:button_text="@string/common.button.exit"
                app:button_textColor_DARK="@color/button_textColor_dark"
                app:button_textColor_FOCUS="@color/button_textColor_focus"
                app:button_textColor_LIGHT="@color/button_textColor_light"
                app:button_textColor_SUN="@color/button_textColor_sun"
                app:button_textSize="@dimen/onboarding_button_text"/>
        </LinearLayout>
        <com.blloc.uicomponents.buttons.BllocButton
            android:id="@+id/onboarding_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
            app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
            app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
            app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
            app:button_isFilled="true"
            app:button_text="@string/common.button.next"
            app:button_textColor_DARK="@color/button_textColor_dark"
            app:button_textColor_FOCUS="@color/button_textColor_focus"
            app:button_textColor_LIGHT="@color/button_textColor_light"
            app:button_textColor_SUN="@color/button_textColor_sun"
            app:button_textSize="@dimen/onboarding_button_text"/>
    </LinearLayout>
</com.blloc.uicomponents.old.customviews.ThemeableFrameLayout>
