<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableImageView
        android:gravity="center_vertical"
        android:layout_width="@dimen/setting_row_icon_size"
        android:layout_height="@dimen/setting_row_icon_size"
        android:layout_marginRight="@dimen/setting_row_icon_margin_right"
        android:src="@drawable/ic_settings_telegram"
        app:imageColor_DARK="@color/white"
        app:imageColor_FOCUS="@color/white"
        app:imageColor_LIGHT="@color/white"
        app:imageColor_SUN="@color/gray_50"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:animateLayoutChanges="true">
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/service_text"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telegram"
            android:fontFamily="@font/medium"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_50"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/service_text_detail"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:fontFamily="@font/demi_bold"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_50"/>
        <EditText
            android:textColor="#323232"
            android:gravity="center_vertical"
            android:id="@+id/service_input"
            android:background="@drawable/rounded_corners_50dp_fill"
            android:paddingRight="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:fontFamily="@font/demi_bold"
            android:backgroundTint="#cdcdcd"
            android:paddingHorizontal="15dp"
            android:paddingVertical="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBllocButton
            android:textSize="12dp"
            android:id="@+id/action_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login"
            android:fontFamily="@font/medium"
            android:layout_marginHorizontal="10dp"
            app:buttonBllocStyle="outline"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_50"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBllocButton
            android:textSize="12dp"
            android:id="@+id/reset_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Reset"
            android:fontFamily="@font/medium"
            android:layout_marginHorizontal="10dp"
            app:buttonBllocStyle="outline"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_50"/>
    </LinearLayout>
    <com.blloc.bllocjavatree.ui.utils.BllocSwitch
        android:id="@+id/service_active_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:checked="false"/>
</LinearLayout>
