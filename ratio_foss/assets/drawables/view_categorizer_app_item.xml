<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/categorizer_app_root"
    android:paddingTop="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <ImageView
        android:id="@+id/categorizer_app_icon"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:adjustViewBounds="true"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="18sp"
        android:gravity="center_vertical"
        android:id="@+id/categorizer_app_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:fontFamily="@font/medium"
        app:textColor_DARK="@color/bottom_sheet_text_dark"
        app:textColor_FOCUS="@color/bottom_sheet_text_focus"
        app:textColor_LIGHT="@color/bottom_sheet_text_light"
        app:textColor_SUN="@color/bottom_sheet_text_sun"/>
</LinearLayout>
