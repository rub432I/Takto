<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="left"
    android:orientation="horizontal"
    android:id="@+id/edit_tag_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:paddingHorizontal="5dp"
    android:paddingVertical="1dp">
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:gravity="center"
        android:id="@+id/edit_tag_icon_container"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginRight="10dp"
        app:linearBackground_DARK="@color/white"
        app:linearBackground_FOCUS="@color/white"
        app:linearBackground_LIGHT="@color/white"
        app:linearBackground_SUN="@color/gray_20"
        app:linearLayout_corner_radius="50dp">
        <com.vanniktech.emoji.EmojiEditText
            android:textSize="18sp"
            android:gravity="center"
            android:id="@+id/emojiEditText"
            android:background="@null"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:text="������"
            android:cursorVisible="false"
            android:maxLines="1"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend"
            android:textIsSelectable="false"/>
    </com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:gravity="center"
        android:layout_gravity="left"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp"
        android:paddingVertical="3dp"
        app:linearBackground_DARK="@color/white"
        app:linearBackground_FOCUS="@color/white"
        app:linearBackground_LIGHT="@color/white"
        app:linearBackground_SUN="@color/gray_20"
        app:linearLayout_corner_radius="@dimen/conversation_options_item_corners">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="18sp"
            android:textColor="#33000000"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="#"
            android:fontFamily="@font/bold"
            app:textColor_DARK="@color/black"
            app:textColor_FOCUS="@color/black"
            app:textColor_LIGHT="@color/black"
            app:textColor_SUN="@color/black"/>
        <com.blloc.uicomponents.old.customviews.ThemeableEditText
            android:textSize="18sp"
            android:gravity="left"
            android:id="@+id/edit_tag_label"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="130dp"
            android:maxLines="1"
            android:maxLength="16"
            android:inputType="textNoSuggestions"
            android:textCursorDrawable="@null"
            android:fontFamily="@font/bold"
            app:textColor_DARK="@color/black"
            app:textColor_FOCUS="@color/black"
            app:textColor_LIGHT="@color/black"
            app:textColor_SUN="@color/black"/>
    </com.blloc.uicomponents.old.customviews.ThemeableLinearLayout> &gt; 
</LinearLayout>
