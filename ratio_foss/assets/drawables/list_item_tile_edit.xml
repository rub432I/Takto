<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/edit_menu"
    android:background="@drawable/tile_edit_menu_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/hide_btn"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/tile_edit_menu_button_hide"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/mute_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/tile_edit_menu_button_mute"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/lock_btn"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/tile_edit_menu_button_lock"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/delete_btn"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/tile_edit_menu_button_delete"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/highlight_btn"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/test_app_icon_5"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
