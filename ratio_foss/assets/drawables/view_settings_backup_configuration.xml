<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottomsheet_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/bottomsheet_extra_padding_horizontal">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/bottom_sheet_title"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/bottom_sheet_title"
            android:paddingLeft="@dimen/setting_item_padding_horizontal"
            android:paddingBottom="@dimen/bottomsheet_title_padding_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings.tiles_configuration.settinglabel"
            android:fontFamily="@font/heavy"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/settings.tiles_configuration.backup"
            app:settingItem_icon="@drawable/settings_icon_tiles_backup"
            app:settingItem_text="@string/common.button.backup"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/settings.tiles_configuration.restore"
            app:settingItem_icon="@drawable/icon_restore"
            app:settingItem_text="@string/common.button.restore"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/settings.tiles_configuration.reset"
            app:settingItem_icon="@drawable/settings_icon_general_restart"
            app:settingItem_text="@string/common.button.reset"/>
    </LinearLayout>
</merge>
