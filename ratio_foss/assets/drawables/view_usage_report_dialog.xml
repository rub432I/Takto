<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/rounded_corners_20dp_fill_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        android:layout_centerVertical="true"
        android:backgroundTint="#1f1f1f"
        android:paddingHorizontal="30dp"
        android:paddingVertical="60dp">
        <TextView
            android:textSize="30dp"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Help us improve Ratio"
            android:fontFamily="@font/bold"/>
        <TextView
            android:textSize="20dp"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Let us know how Ratio affected your usage of your device"
            android:fontFamily="@font/bold"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="By tapping accept, you&apos;ll send us completely anonymous data about the time you spent on each app the week before using ratio and the week after.\10\10At Blloc we take privacy very seriously and we&apos;ll never share data with any third party."
            android:fontFamily="@font/bold"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:gravity="center_horizontal"
                android:id="@+id/btn_decline"
                android:background="@drawable/rounded_corners_10dp_outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10sp"
                android:text="Decline"
                android:fontFamily="@font/bold"
                android:paddingHorizontal="30dp"
                android:paddingVertical="3dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#1f1f1f"
                android:gravity="center_horizontal"
                android:id="@+id/btn_accept"
                android:background="@drawable/rounded_corners_50dp_fill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10sp"
                android:layout_marginTop="20dp"
                android:text="Accept"
                android:fontFamily="@font/bold"
                android:backgroundTint="#ffffff"
                android:paddingHorizontal="30dp"
                android:paddingVertical="3dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
