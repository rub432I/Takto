<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_container"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="30dp">
    <ImageView
        android:id="@+id/ticket_qr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20dp"
        android:textColor="@color/ticket_top_text_title"
        android:id="@+id/passengerNameTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/view_ticket_top_pdf_bottom_info_margin_top"
        android:maxLines="2"
        android:fontFamily="@font/heavy"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/separator_1"
        app:layout_constraintTop_toBottomOf="@+id/ticket_qr"/>
    <View
        android:id="@+id/separator_1"
        android:background="#000000"
        android:layout_width="1dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/view_ticket_top_pdf_bottom_info_margin_top"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintLeft_toRightOf="@+id/passengerNameTV"
        app:layout_constraintRight_toLeftOf="@+id/flight_IATATV"
        app:layout_constraintTop_toBottomOf="@+id/ticket_qr"/>
    <TextView
        android:textSize="20dp"
        android:textColor="@color/ticket_top_text_title"
        android:id="@+id/flight_IATATV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/view_ticket_top_pdf_bottom_info_margin_top"
        android:fontFamily="@font/bold"
        app:layout_constraintLeft_toRightOf="@+id/separator_1"
        app:layout_constraintRight_toLeftOf="@+id/separator_2"
        app:layout_constraintTop_toBottomOf="@+id/ticket_qr"/>
    <View
        android:id="@+id/separator_2"
        android:background="#000000"
        android:layout_width="1dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/view_ticket_top_pdf_bottom_info_margin_top"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintLeft_toRightOf="@+id/flight_IATATV"
        app:layout_constraintRight_toLeftOf="@+id/seatContainerLL"
        app:layout_constraintTop_toBottomOf="@+id/ticket_qr"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/seatContainerLL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:translationY="0dp"
        app:layout_constraintLeft_toRightOf="@+id/separator_2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ticket_qr">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ticket_top_text_title"
            android:id="@+id/seatTitleTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seat"
            android:translationY="15dp"
            android:fontFamily="@font/bold"/>
        <TextView
            android:textSize="50dp"
            android:textColor="@color/ticket_top_text_title"
            android:gravity="bottom"
            android:id="@+id/seatTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/heavy"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10dp"
            android:autoSizeMaxTextSize="60dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
