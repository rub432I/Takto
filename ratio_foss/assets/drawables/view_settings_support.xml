<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottomsheet_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/bottomsheet_extra_padding_horizontal">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/bottom_sheet_title"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/bottom_sheet_title"
            android:paddingLeft="@dimen/setting_item_padding_horizontal"
            android:paddingBottom="@dimen/bottomsheet_title_padding_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_support_title"
            android:fontFamily="@font/heavy"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_discord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/settings_about_support_discord_description"
            app:settingItem_icon="@drawable/icon_discord"
            app:settingItem_text="@string/settings_about_support_discord_title"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_bug_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/settings_about_support_bug_report_description"
            app:settingItem_icon="@drawable/settings_icon_devs_debug"
            app:settingItem_text="@string/settings_about_support_bug_report_title"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_description="@string/settings_feedback_description"
            app:settingItem_icon="@drawable/icon_feedback"
            app:settingItem_text="@string/settings_feedback_title"/>
    </LinearLayout>
</merge>
