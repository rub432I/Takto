<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_screen_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <com.blloc.bllocjavatree.ui.headerview.HeaderView
        android:id="@+id/header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:animateLayoutChanges="true"
        android:elevation="2dp"/>
    <com.blloc.bllocjavatree.ui.sections.mainscreen.multipleselection.MultipleSelection
        android:id="@+id/multiple_selection"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header_view"
        android:animateLayoutChanges="true"
        android:alpha="1"
        android:elevation="2dp"/>
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBlurView
        android:id="@+id/pinned_conversations_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        app:blurDisabledColor_DARK="@color/gray_80"
        app:blurDisabledColor_LIGHT="@color/gray_70"
        app:cornerRadius="@dimen/corner_radius_large"
        app:foregroundColor_DARK="@color/background_sec_dark"
        app:foregroundColor_FOCUS="@color/background_sec_focus"
        app:foregroundColor_LIGHT="@color/background_sec_light"
        app:foregroundColor_SUN="@color/background_sec_sun">
        <com.blloc.bllocjavatree.ui.sections.mainscreen.pinnedconversations.PinnedConversationsView
            android:id="@+id/pinned_conversations"
            android:background="@drawable/background_corners_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:paddingVertical="@dimen/card_vertical_padding"
            app:background_DARK="@color/background_sec_dark"
            app:background_FOCUS="@color/background_sec_focus"
            app:background_LIGHT="@color/background_sec_light"
            app:background_SUN="@color/background_sec_sun"
            app:blurDisabledColor_DARK="@color/gray_80"
            app:blurDisabledColor_LIGHT="@color/gray_70"
            app:layout_goneMarginBottom="0dp"/>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableBlurView>
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="false"
        android:animateLayoutChanges="true">
        <com.blloc.bllocjavatree.ui.sections.mainscreen.allconversations.AllConversationsView
            android:id="@+id/all_conversations_list"
            android:background="@color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="1"
            android:paddingVertical="@dimen/card_vertical_padding"/>
    </LinearLayout>
</RelativeLayout>
