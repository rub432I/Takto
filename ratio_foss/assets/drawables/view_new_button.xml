<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="150dp">
        <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
            android:id="@+id/button_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:linearBackground_DARK="@color/standard_buttonBg_dark"
            app:linearBackground_FOCUS="@color/standard_buttonBg_focus"
            app:linearBackground_LIGHT="@color/standard_buttonBg_light"
            app:linearBackground_SUN="@color/standard_buttonBg_sun"
            app:linearLayout_corner_radius="@dimen/setting_item_corner_radius"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/setting_item_root"
            android:background="@drawable/touch_ripple"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/setting_item_padding_horizontal"
            android:paddingVertical="@dimen/setting_item_padding_vertical">
            <com.blloc.uicomponents.old.customviews.ThemeableImageView
                android:id="@+id/setting_item_icon"
                android:layout_width="@dimen/setting_item_icon_size"
                android:layout_height="@dimen/setting_item_icon_size"
                android:layout_marginRight="@dimen/setting_item_padding_horizontal"
                app:imageColor_DARK="@color/standard_icon_dark"
                app:imageColor_FOCUS="@color/standard_icon_focus"
                app:imageColor_LIGHT="@color/standard_icon_light"
                app:imageColor_SUN="@color/standard_icon_sun"/>
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/setting_item_text"
                android:gravity="center_vertical"
                android:id="@+id/setting_item_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                app:textColor_DARK="@color/standard_text_dark"
                app:textColor_FOCUS="@color/standard_text_focus"
                app:textColor_LIGHT="@color/standard_text_light"
                app:textColor_SUN="@color/standard_text_sun"/>
        </LinearLayout>
    </FrameLayout>
</merge>
