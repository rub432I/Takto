<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/setting_item_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/settings_item_paddingH"
    android:paddingVertical="@dimen/settings_item_paddingV">
    <com.blloc.uicomponents.old.customviews.ThemeableImageView
        android:id="@+id/setting_item_icon"
        android:layout_width="@dimen/settings_item_iconHeight"
        android:layout_height="@dimen/settings_item_iconHeight"
        android:layout_marginRight="@dimen/settings_item_icon_marginR"
        app:imageColor_DARK="@color/white"
        app:imageColor_FOCUS="@color/white"
        app:imageColor_LIGHT="@color/white"
        app:imageColor_SUN="@color/gray_50"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="@dimen/setting_item_text"
        android:gravity="center"
        android:id="@+id/setting_item_text"
        android:paddingRight="@dimen/settings_item_icon_marginR"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/medium"
        app:textColor_DARK="@color/white"
        app:textColor_FOCUS="@color/white"
        app:textColor_LIGHT="@color/white"
        app:textColor_SUN="@color/gray_50"/>
    <com.blloc.uicomponents.old.customviews.ThemeableRadioButton
        android:id="@+id/setting_item_radio_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:radioButtonColor_DARK="@color/white"
        app:radioButtonColor_FOCUS="@color/white"
        app:radioButtonColor_LIGHT="@color/white"
        app:radioButtonColor_SUN="@color/gray_50"/>
</LinearLayout>
