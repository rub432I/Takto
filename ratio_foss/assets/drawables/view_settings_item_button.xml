<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/settings_item_paddingH"
    android:paddingVertical="@dimen/settings_item_paddingV">
    <com.blloc.uicomponents.old.customviews.ThemeableImageView
        android:id="@+id/setting_item_icon"
        android:layout_width="@dimen/settings_item_iconHeight"
        android:layout_height="@dimen/settings_item_iconHeight"
        android:layout_marginRight="@dimen/settings_item_icon_marginR"
        app:imageColor_DARK="@color/white"
        app:imageColor_FOCUS="@color/white"
        app:imageColor_LIGHT="@color/white"
        app:imageColor_SUN="@color/gray_50"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/settings_item_icon_marginR"
        android:layout_weight="1">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/settings_item_textSize"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/setting_item_text"
            android:paddingRight="@dimen/settings_item_text_marginR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medium"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_50"/>
        <com.blloc.uicomponents.old.customviews.ThemeableImageView
            android:id="@+id/setting_item_info"
            android:visibility="gone"
            android:layout_width="@dimen/settings_item_iconHeight"
            android:layout_height="@dimen/settings_item_iconHeight"
            android:src="@drawable/settings_icon_question"
            app:imageColor_DARK="@color/white"
            app:imageColor_FOCUS="@color/white"
            app:imageColor_LIGHT="@color/white"
            app:imageColor_SUN="@color/gray_50"/>
    </LinearLayout>
    <com.blloc.uicomponents.buttons.BllocButton
        android:id="@+id/setting_item_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
        app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
        app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
        app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
        app:button_isFilled="false"
        app:button_text="@string/placeholder"
        app:button_textColor_DARK="@color/button_textColor_dark"
        app:button_textColor_FOCUS="@color/button_textColor_focus"
        app:button_textColor_LIGHT="@color/button_textColor_light"
        app:button_textColor_SUN="@color/button_textColor_sun"/>
</LinearLayout>
