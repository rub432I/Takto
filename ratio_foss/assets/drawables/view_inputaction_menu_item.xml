<?xml version="1.0" encoding="utf-8"?>
<com.blloc.bllocjavatree.ui.utils.RNLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/action_menu_margin_bottom"
    android:paddingHorizontal="5dp">
    <com.blloc.uicomponents.old.customviews.ThemeableSelectableText
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:selectedTextColor_DARK="@color/blloc_yellow"
        app:selectedTextColor_FOCUS="@color/blloc_yellow"
        app:selectedTextColor_LIGHT="@color/action_text_light"
        app:selectedTextColor_SUN="@color/action_text_sun"
        app:unselectedTextColor_DARK="@color/action_text_dark"
        app:unselectedTextColor_FOCUS="@color/action_text_focus"
        app:unselectedTextColor_LIGHT="@color/action_text_light"
        app:unselectedTextColor_SUN="@color/action_text_sun"/>
    <com.blloc.uicomponents.old.customviews.ThemeableSelectableIconBackground
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:padding="12.5dp"
        android:layout_width="@dimen/action_menu_height"
        android:layout_height="@dimen/action_menu_height"
        android:src="@drawable/inputaction_theme_dark"
        app:iconTint_DARK="@color/action_icon_dark"
        app:iconTint_FOCUS="@color/action_icon_focus"
        app:iconTint_LIGHT="@color/action_icon_light"
        app:iconTint_SUN="@color/action_icon_sun"
        app:selectedImageBackground_DARK="@color/blloc_yellow"
        app:selectedImageBackground_FOCUS="@color/blloc_yellow"
        app:selectedImageBackground_LIGHT="@color/blloc_yellow"
        app:selectedImageBackground_SUN="@color/blloc_yellow"
        app:unselectedImageBackground_DARK="@color/actionBackground_dark"
        app:unselectedImageBackground_FOCUS="@color/actionBackground_focus"
        app:unselectedImageBackground_LIGHT="@color/actionBackground_light"
        app:unselectedImageBackground_SUN="@color/actionBackground_sun"/>
    <com.blloc.uicomponents.old.customviews.ThemeableSelectableLinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/tag_icon_container"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="@dimen/action_menu_height"
        android:layout_height="@dimen/action_menu_height"
        android:alpha="1"
        app:selectableCornerRadius="50dp"
        app:selectedBackground_DARK="@color/blloc_yellow"
        app:selectedBackground_FOCUS="@color/blloc_yellow"
        app:selectedBackground_LIGHT="@color/blloc_yellow"
        app:selectedBackground_SUN="@color/blloc_yellow"
        app:unselectedBackground_DARK="@color/actionBackground_dark"
        app:unselectedBackground_FOCUS="@color/actionBackground_focus"
        app:unselectedBackground_LIGHT="@color/actionBackground_light"
        app:unselectedBackground_SUN="@color/actionBackground_sun">
        <com.vanniktech.emoji.EmojiTextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:id="@+id/tag_icon"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="������"
            android:textIsSelectable="false"/>
    </com.blloc.uicomponents.old.customviews.ThemeableSelectableLinearLayout>
</com.blloc.bllocjavatree.ui.utils.RNLinearLayout>
