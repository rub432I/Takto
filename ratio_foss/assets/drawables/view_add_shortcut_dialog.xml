<?xml version="1.0" encoding="utf-8"?>
<com.blloc.uicomponents.old.customviews.ThemeableBottomSheet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="500dp"
    app:behavior_hideable="true"
    app:behavior_peekHeight="100dp"
    app:layout_behavior="android.support.design.widget.BottomSheetBehavior"
    app:linearBackground_DARK="@color/bottom_sheet_background_dark"
    app:linearBackground_FOCUS="@color/bottom_sheet_background_dark"
    app:linearBackground_LIGHT="@color/bottom_sheet_background_light"
    app:linearBackground_SUN="@color/bottom_sheet_background_light"
    app:linearLayout_corner_radius="16dp">
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:layout_width="@dimen/bottom_sheet_handle_width"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:layout_marginTop="@dimen/bottom_sheet_handle_marginT"
        android:layout_marginBottom="@dimen/bottom_sheet_handle_marginB"
        app:linearBackground_DARK="@color/bottom_sheet_handle_dark"
        app:linearBackground_FOCUS="@color/bottom_sheet_handle_focus"
        app:linearBackground_LIGHT="@color/bottom_sheet_handle_light"
        app:linearBackground_SUN="@color/bottom_sheet_handle_sun"
        app:linearLayout_corner_radius="@dimen/bottom_sheet_handle_corners"/>
    <androidx.core.widget.NestedScrollView
        android:gravity="top|center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="@dimen/bottom_sheet_paddingH"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/bottom_sheet_paddingH">
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/bottom_sheet_title"
                android:gravity="center"
                android:id="@+id/bottom_sheet_title"
                android:paddingTop="@dimen/bottom_sheet_item_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_to_homescreen_title"
                android:fontFamily="@font/heavy"
                app:textColor_DARK="@color/bottom_sheet_text_dark"
                app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                app:textColor_LIGHT="@color/bottom_sheet_text_light"
                app:textColor_SUN="@color/bottom_sheet_text_sun"/>
            <com.blloc.uicomponents.view.BlurTileView
                android:id="@+id/tileView"
                android:layout_width="80dp"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/bottom_sheet_description"
                android:gravity="center"
                android:id="@+id/bottom_sheet_description"
                android:paddingTop="@dimen/bottom_sheet_item_margin"
                android:paddingBottom="@dimen/bottom_sheet_item_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_to_homescreen_description"
                android:fontFamily="@font/medium"
                android:paddingHorizontal="30dp"
                app:textColor_DARK="@color/bottom_sheet_text_dark"
                app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                app:textColor_LIGHT="@color/bottom_sheet_text_light"
                app:textColor_SUN="@color/bottom_sheet_text_sun"/>
            <com.blloc.uicomponents.buttons.BllocButton
                android:id="@+id/cancelBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/bottom_sheet_button_paddingH"
                android:layout_marginVertical="@dimen/bottom_sheet_button_paddingV"
                app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
                app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
                app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
                app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
                app:button_isFilled="false"
                app:button_text="@string/common.button.cancel"
                app:button_textColor_DARK="@color/button_textColor_dark"
                app:button_textColor_FOCUS="@color/button_textColor_focus"
                app:button_textColor_LIGHT="@color/button_textColor_light"
                app:button_textColor_SUN="@color/button_textColor_sun"
                app:button_textSize="@dimen/bottom_sheet_button_text"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.blloc.uicomponents.old.customviews.ThemeableBottomSheet>
