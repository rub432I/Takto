<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/categorizer_dismiss_popup"
        android:background="#88000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerVertical="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/categorizer_popup"
            android:background="@drawable/rounded_corners_20dp_fill_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="35dp"
            android:layout_centerVertical="true"
            android:backgroundTint="#1f1f1f"
            android:paddingHorizontal="30dp"
            android:paddingVertical="35dp">
            <TextView
                android:textSize="30dp"
                android:textColor="#ffffff"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tiles.categorizer.title"
                android:fontFamily="@font/bold"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/categorizer_hide_loading"
                android:background="@drawable/rounded_corners_20dp_fill_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:backgroundTint="#1f1f1f">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:gravity="center_horizontal"
                    android:id="@+id/categorizer_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tiles.categorizer.text"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="@font/medium"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tiles.categorizer.backup"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="@font/medium"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#1f1f1f"
                    android:gravity="center_horizontal"
                    android:id="@+id/btn_backup"
                    android:background="@drawable/rounded_corners_50dp_fill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Backup"
                    android:fontFamily="@font/bold"
                    android:backgroundTint="#ffffff"
                    android:layout_marginVertical="25dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="4dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:gravity="center_horizontal"
                    android:id="@+id/categorizer_popup_consent"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tiles.categorizer.terms"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="@font/medium"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:gravity="center_horizontal"
                    android:id="@+id/categorizer_no_internet"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tiles.categorizer.continue"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="@font/medium"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:gravity="center_horizontal"
                        android:id="@+id/btn_decline"
                        android:background="@drawable/rounded_corners_10dp_outline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:text="@string/common.button.cancel"
                        android:fontFamily="@font/bold"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="4dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#1f1f1f"
                        android:gravity="center_horizontal"
                        android:id="@+id/btn_accept"
                        android:background="@drawable/rounded_corners_50dp_fill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15sp"
                        android:text="@string/common.button.yes"
                        android:fontFamily="@font/bold"
                        android:backgroundTint="#ffffff"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="4dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/categorizer_loading"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#ffffff"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tiles.categorizer.categorizing"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="@font/medium"
                    android:layout_marginVertical="30dp"/>
                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:indeterminateDrawable="@drawable/categorizer_progress"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
