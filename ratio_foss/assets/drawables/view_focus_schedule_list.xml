<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/focus_hour_list_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:linearBackground_DARK="@color/backgroundOpacity_dark"
        app:linearBackground_FOCUS="@color/backgroundOpacity_focus"
        app:linearBackground_LIGHT="@color/backgroundOpacity_light"
        app:linearBackground_SUN="@color/backgroundOpacity_sun"
        app:linearLayout_corner_radius="0dp">
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="30dp"
            android:textColor="@color/gray_20"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tree.focus_hours.title.focus_hours"
            android:fontFamily="@font/bold"
            android:layout_marginVertical="30dp"
            app:textColor_DARK="@color/settingTextMain_dark"
            app:textColor_FOCUS="@color/settingTextMain_focus"
            app:textColor_LIGHT="@color/settingTextMain_light"
            app:textColor_SUN="@color/settingTextMain_sun"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:fadeScrollbars="false"
            android:scrollIndicators="top">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/focus_hour_added_container"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/empty_layout_divider"
                android:minHeight="400dp"
                android:animateLayoutChanges="true"
                android:showDividers="middle"
                android:paddingHorizontal="50dp"
                android:paddingVertical="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </ScrollView>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="30dp">
            <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/focus_hour_list_exit_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonIsFilled="false"
                app:buttonText="@string/common.button.exit"
                app:buttonType="Cancel"
                app:layout_constraintEnd_toEndOf="parent"/>
            <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/focus_hour_list_add_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonIsFilled="true"
                app:buttonText="@string/common.button.new"
                app:buttonType="Add"
                app:layout_constraintEnd_toEndOf="parent"/>
        </LinearLayout>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
