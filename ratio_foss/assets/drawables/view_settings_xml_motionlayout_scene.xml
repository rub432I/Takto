<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="1000">
        <KeyFrameSet/>
    </Transition>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/setting_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/general_setting_item_height"
            motion:layout_constraintEnd_toEndOf="@+id/linearLayout"
            motion:layout_constraintStart_toStartOf="@+id/linearLayout"
            motion:layout_constraintTop_toBottomOf="@+id/linearLayout"/>
        <Constraint
            android:id="@+id/imageView"
            android:layout_width="@dimen/motion_layout_width"
            android:layout_height="@dimen/motion_layout_width"
            android:layout_marginBottom="0dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/linearLayout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/general_setting_item_height"
            motion:layout_constraintEnd_toEndOf="@+id/imageView"
            motion:layout_constraintStart_toStartOf="@+id/imageView"
            motion:layout_constraintTop_toBottomOf="@+id/imageView"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/imageView"
            android:layout_width="@dimen/motion_layout_width"
            android:layout_height="@dimen/motion_layout_width"
            android:layout_marginBottom="@dimen/space_shortcut_with_short_cut_text"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/linearLayout"
            motion:layout_constraintHorizontal_chainStyle="packed"
            motion:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/linearLayout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/general_setting_item_height"
            android:layout_marginLeft="@dimen/logo_item_left_padding"
            android:layout_marginBottom="@dimen/logo_margin_bottom"
            android:layout_marginStart="@dimen/logo_item_left_padding"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@+id/setting_title"
            motion:layout_constraintHorizontal_chainStyle="packed"
            motion:layout_constraintStart_toEndOf="@+id/imageView"/>
        <Constraint
            android:id="@+id/setting_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/general_setting_item_height"
            android:layout_marginLeft="@dimen/item_left_padding"
            android:layout_marginStart="@dimen/item_left_padding"
            motion:layout_constraintBottom_toBottomOf="@+id/linearLayout"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintHorizontal_chainStyle="packed"
            motion:layout_constraintStart_toEndOf="@+id/linearLayout"/>
    </ConstraintSet>
</MotionScene>
