<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition
        android:id="@+id/transition_open_conversation"
        app:constraintSetEnd="@+id/state_conversation_open"
        app:constraintSetStart="@+id/state_main"/>
    <ConstraintSet android:id="@+id/state_main">
        <Constraint
            android:id="@+id/conversation_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:translationX="500dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/state_conversation_open">
        <Constraint
            android:id="@+id/conversation_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="1"
            android:translationX="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </ConstraintSet>
</MotionScene>
