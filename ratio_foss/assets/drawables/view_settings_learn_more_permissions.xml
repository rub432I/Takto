<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottomsheet_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/bottomsheet_extra_padding_horizontal">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/bottom_sheet_title"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/bottom_sheet_title"
            android:paddingBottom="@dimen/bottomsheet_title_padding_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.onboarding.permissions.title"
            android:fontFamily="@font/heavy"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_notifications_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_bold="true"
            app:settingItem_clickable="false"
            app:settingItem_text="@string/common_notifications"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/permission_item_padding_left"
            android:paddingRight="@dimen/permission_item_padding_right"
            android:paddingBottom="@dimen/permission_item_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.tile_display_notifs.name"
                app:permissionInfo_section="@string/permissions.feature_categories.tiles.name"/>
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.tree_receive_messages.name"
                app:permissionInfo_section="@string/permissions.feature_categories.tree.name"/>
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.media_cards.name"
                app:permissionInfo_section="@string/permissions.feature_categories.root.name"/>
        </LinearLayout>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_usage_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_bold="true"
            app:settingItem_clickable="false"
            app:settingItem_text="@string/tiles.usage_access.title"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/permission_item_padding_left"
            android:paddingRight="@dimen/permission_item_padding_right"
            android:paddingBottom="@dimen/permission_item_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.tiles_display_appusage_stats.name"
                app:permissionInfo_section="@string/permissions.feature_categories.tiles.name"/>
        </LinearLayout>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_bold="true"
            app:settingItem_clickable="false"
            app:settingItem_text="@string/permissions.categories.phone.name"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/permission_item_padding_left"
            android:paddingRight="@dimen/permission_item_padding_right"
            android:paddingBottom="@dimen/permission_item_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.tree_phone_calls.name"
                app:permissionInfo_section="@string/permissions.feature_categories.tree.name"/>
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.app_data_usage.name"
                app:permissionInfo_section="@string/permissions.feature_categories.tiles.name"/>
        </LinearLayout>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_bold="true"
            app:settingItem_clickable="false"
            app:settingItem_text="@string/permissions.categories.contacts.name"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/permission_item_padding_left"
            android:paddingRight="@dimen/permission_item_padding_right"
            android:paddingBottom="@dimen/permission_item_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.tree_contacts.name"
                app:permissionInfo_section="@string/permissions.feature_categories.tree.name"/>
        </LinearLayout>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_bold="true"
            app:settingItem_clickable="false"
            app:settingItem_text="@string/permissions.categories.calendar.name"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/permission_item_padding_left"
            android:paddingRight="@dimen/permission_item_padding_right"
            android:paddingBottom="@dimen/permission_item_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.calendar_card.name"
                app:permissionInfo_section="@string/permissions.feature_categories.root.name"/>
        </LinearLayout>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_bold="true"
            app:settingItem_clickable="false"
            app:settingItem_text="@string/permissions.categories.location.name"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/permission_item_padding_left"
            android:paddingRight="@dimen/permission_item_padding_right"
            android:paddingBottom="@dimen/permission_item_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.weather_here.name"
                app:permissionInfo_section="@string/permissions.feature_categories.root.name"/>
        </LinearLayout>
        <com.blloc.uicomponents.view.SettingItem
            android:id="@+id/setting_item_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingItem_bold="true"
            app:settingItem_clickable="false"
            app:settingItem_text="@string/permissions.categories.camera.name"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/permission_item_padding_left"
            android:paddingRight="@dimen/permission_item_padding_right"
            android:paddingBottom="@dimen/permission_item_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bllocosn.ui.main.settings.permissions.PermissionDescription
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:permissionInfo_description="@string/permissions.features.root_tickets_scan.name"
                app:permissionInfo_section="@string/permissions.feature_categories.root.name"/>
        </LinearLayout>
    </LinearLayout>
</merge>
