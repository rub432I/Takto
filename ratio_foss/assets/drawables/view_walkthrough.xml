<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.bllocjavatiles.onboarding.WalkthroughBackgroundView
        android:id="@+id/walkthrough_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/walkthrough_explanation_1"
        android:layout_width="250dp"
        android:layout_height="80dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="180dp"
        android:src="@drawable/walkthrough_explanation_1"
        android:alpha="0"/>
    <ImageView
        android:id="@+id/walkthrough_explanation_2"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:layout_marginTop="390dp"
        android:src="@drawable/walkthrough_explanation_2"
        android:layout_centerHorizontal="true"
        android:alpha="0"/>
    <ImageView
        android:id="@+id/walkthrough_explanation_3"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:layout_marginTop="310dp"
        android:src="@drawable/walkthrough_explanation_3"
        android:layout_centerHorizontal="true"
        android:alpha="0"/>
    <ImageView
        android:id="@+id/walkthrough_explanation_4"
        android:layout_width="250dp"
        android:layout_height="85dp"
        android:layout_marginTop="500dp"
        android:src="@drawable/walkthrough_explanation_4"
        android:layout_centerHorizontal="true"
        android:alpha="0"/>
    <ImageView
        android:id="@+id/walkthrough_explanation_5"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:layout_marginTop="570dp"
        android:src="@drawable/walkthrough_explanation_5"
        android:layout_centerHorizontal="true"
        android:alpha="0"/>
    <ImageView
        android:id="@+id/walkthrough_explanation_6"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="570dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="75dp"
        android:src="@drawable/walkthrough_explanation_6"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:alpha="0"/>
    <RelativeLayout
        android:visibility="gone"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_margin="12dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <View
            android:background="#ff0000"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/walkthrough_btn_next"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="30dp"
        android:src="@drawable/walkthrough_btn_next"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:alpha="1"/>
    <ImageView
        android:id="@+id/walkthrough_btn_skip"
        android:paddingTop="15dp"
        android:paddingBottom="5dp"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:layout_marginBottom="30dp"
        android:src="@drawable/walkthrough_btn_skip"
        android:layout_toLeftOf="@+id/walkthrough_btn_next"
        android:layout_alignParentBottom="true"
        android:alpha="1"/>
</RelativeLayout>
