<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/frameEmailInput"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="28dp"
            android:gravity="center"
            android:id="@+id/ratioTreeTitleTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:text="RatioTree"
            android:fontFamily="@font/extra_bold"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="18dp"
            android:gravity="center"
            android:id="@+id/ratioTreeSubtitleTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/tree.login_screen.sign_up_explanation.text"
            android:fontFamily="@font/medium"
            android:layout_marginHorizontal="88dp"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_70"/>
        <com.blloc.uicomponents.old.customviews.ThemeableBlurView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="88dp"
            android:paddingVertical="8dp"
            app:cornerRadius="16dp"
            app:foregroundColor_DARK="@color/opacity_light_30"
            app:foregroundColor_FOCUS="@color/gray_80"
            app:foregroundColor_LIGHT="@color/opacity_light_30"
            app:foregroundColor_SUN="@color/gray_20">
            <com.blloc.uicomponents.old.customviews.ThemeableEditText
                android:textSize="14dp"
                android:textColorHint="@color/gray_50"
                android:id="@+id/emailInput"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="example@gmail.com"
                android:fontFamily="@font/medium"
                android:paddingHorizontal="16dp"
                app:textColor_DARK="@color/white"
                app:textColor_FOCUS="@color/white"
                app:textColor_LIGHT="@color/white"
                app:textColor_SUN="@color/gray_70"/>
        </com.blloc.uicomponents.old.customviews.ThemeableBlurView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/frameEmailSent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.blloc.uicomponents.old.customviews.ThemeableImageView
            android:gravity="center"
            android:id="@+id/emailSentIV"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_email_sent"
            android:fontFamily="@font/extra_bold"
            app:imageColor_DARK="@color/white"
            app:imageColor_FOCUS="@color/white"
            app:imageColor_LIGHT="@color/white"
            app:imageColor_SUN="@color/gray_70"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="18dp"
            android:gravity="center"
            android:id="@+id/emailSentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/tree.login_screen.email_sent_explanation.text"
            android:fontFamily="@font/medium"
            android:layout_marginHorizontal="88dp"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_70"/>
    </LinearLayout>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="13dp"
        android:gravity="center_horizontal"
        android:id="@+id/fineprintTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="You will receive a verification email with an access link. No spam. No marketing"
        android:fontFamily="@font/medium"
        android:layout_marginHorizontal="110dp"
        app:textColor_DARK="@color/white"
        app:textColor_FOCUS="@color/white"
        app:textColor_LIGHT="@color/white"
        app:textColor_SUN="@color/gray_70"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/bottomButtonContainer"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:fontFamily="@font/extra_bold">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="12dp"
            android:gravity="center"
            android:id="@+id/bottomButton"
            android:background="@drawable/rounded_corners_50dp_fill"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Get activation link"
            android:fontFamily="@font/extra_bold"
            android:backgroundTint="@color/white"
            android:paddingHorizontal="25dp"
            app:textColor_DARK="@color/black"
            app:textColor_FOCUS="@color/black"
            app:textColor_LIGHT="@color/black"
            app:textColor_SUN="@color/white"/>
    </FrameLayout>
</LinearLayout>
