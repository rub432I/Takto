<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.bllocjavatiles.custom_views.FadingEdgeLayout
        android:id="@+id/motion_layout_fade"
        android:paddingTop="@dimen/onboarding_padding_top"
        android:paddingBottom="@dimen/onboarding_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/onboarding_navigation_marginB"
        app:fel_edge="bottom|top"
        app:fel_size_bottom="@dimen/onboarding_vertical_fade"
        app:fel_size_top="@dimen/onboarding_vertical_fade">
        <androidx.constraintlayout.motion.widget.MotionLayout
            android:id="@+id/motion_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutDescription="@xml/onboarding_motion_scene">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/horizontal_guideline_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                app:layout_constraintGuide_percent="0"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/horizontal_guideline_middle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                app:layout_constraintGuide_percent="0.5"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/horizontal_guideline_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                app:layout_constraintGuide_percent="0.82"/>
            <com.bllocosn.ui.onboarding.setup.HeaderTop
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/header_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/onboarding_headerTop_height"
                app:layout_constraintBottom_toTopOf="@+id/device"/>
            <FrameLayout
                android:id="@+id/device_container"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/onboarding_device_height"
                android:minHeight="300dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.bllocosn.ui.onboarding.setup.wallpaper.OnboardingWallpaper
                    android:id="@+id/onboarding_wallpaper"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.blloc.uicomponents.viewgroups.RoundedCornersLayout
                        android:layout_gravity="center"
                        android:id="@+id/device"
                        android:background="@drawable/onboarding_drop_shadow"
                        android:clipChildren="true"
                        android:layout_width="@dimen/onboarding_device_width"
                        android:layout_height="@dimen/onboarding_device_height"
                        android:foreground="@drawable/foreground_dock_frame"
                        android:elevation="25dp"
                        app:cornerRadius="@dimen/onboarding_dock_phoneCorners">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:id="@+id/device_wallpaper"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <com.bllocosn.ui.onboarding.setup.categorizer.CategorizerView
                                    android:orientation="vertical"
                                    android:id="@+id/device_categories"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:paddingHorizontal="@dimen/onboarding_categorizer_paddingH"
                                    app:layout_constraintBottom_toTopOf="@+id/device_dock"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <com.bllocosn.ui.onboarding.setup.dock.OnboardingDockView
                                    android:id="@+id/device_dock"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_margin="@dimen/onboarding_dock_dockMargin"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintDimensionRatio="50:14"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </FrameLayout>
                    </com.blloc.uicomponents.viewgroups.RoundedCornersLayout>
                </LinearLayout>
            </FrameLayout>
            <com.bllocosn.ui.onboarding.setup.HeaderBottom
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/header_bottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/onboarding_device_height"
                android:minHeight="@dimen/onboarding_headerBottom_height"
                app:layout_constraintTop_toBottomOf="@+id/device"/>
            <com.blloc.bllocjavatiles.custom_views.FadingEdgeLayout
                android:id="@+id/appdrawer_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:fel_edge="bottom|top"
                app:fel_size_bottom="@dimen/onboarding_app_drawer_paddingT"
                app:fel_size_top="@dimen/onboarding_app_drawer_paddingT"
                app:layout_constraintTop_toBottomOf="parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/app_drawer_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="2dp"/>
            </com.blloc.bllocjavatiles.custom_views.FadingEdgeLayout>
        </androidx.constraintlayout.motion.widget.MotionLayout>
    </com.blloc.bllocjavatiles.custom_views.FadingEdgeLayout>
    <LinearLayout
        android:layout_gravity="bottom|fill_horizontal"
        android:id="@+id/onboarding_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/onboarding_navigation_marginB"
        android:paddingHorizontal="@dimen/onboarding_navigation_paddingH">
        <LinearLayout
            android:layout_gravity="left"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.blloc.uicomponents.buttons.BllocButton
                android:id="@+id/onboarding_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
                app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
                app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
                app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
                app:button_isFilled="false"
                app:button_text="@string/common.button.back"
                app:button_textColor_DARK="@color/button_textColor_dark"
                app:button_textColor_FOCUS="@color/button_textColor_focus"
                app:button_textColor_LIGHT="@color/button_textColor_light"
                app:button_textColor_SUN="@color/button_textColor_sun"
                app:button_textSize="@dimen/onboarding_button_text"/>
        </LinearLayout>
        <com.blloc.uicomponents.buttons.BllocButton
            android:id="@+id/onboarding_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
            app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
            app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
            app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
            app:button_isFilled="true"
            app:button_text="@string/common.button.next"
            app:button_textColor_DARK="@color/button_textColor_dark"
            app:button_textColor_FOCUS="@color/button_textColor_focus"
            app:button_textColor_LIGHT="@color/button_textColor_light"
            app:button_textColor_SUN="@color/button_textColor_sun"
            app:button_textSize="@dimen/onboarding_button_text"/>
    </LinearLayout>
</FrameLayout>
