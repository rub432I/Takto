<?xml version="1.0" encoding="utf-8"?>
<com.blloc.uicomponents.old.customviews.ThemeableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:linearBackground_DARK="@color/bottom_sheet_background_dark"
    app:linearBackground_FOCUS="@color/bottom_sheet_background_focus"
    app:linearBackground_LIGHT="@color/bottom_sheet_background_light"
    app:linearBackground_SUN="@color/bottom_sheet_background_sun"
    app:linearLayout_corner_radius="@dimen/bottom_sheet_corners">
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:layout_gravity="center"
        android:layout_width="@dimen/bottom_sheet_handle_width"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:layout_marginTop="@dimen/bottom_sheet_handle_marginT"
        android:layout_marginBottom="@dimen/bottom_sheet_handle_marginB"
        app:linearBackground_DARK="@color/bottom_sheet_handle_dark"
        app:linearBackground_FOCUS="@color/bottom_sheet_handle_focus"
        app:linearBackground_LIGHT="@color/bottom_sheet_handle_light"
        app:linearBackground_SUN="@color/bottom_sheet_handle_sun"
        app:linearLayout_corner_radius="@dimen/bottom_sheet_handle_corners"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="@dimen/bottom_sheet_title_large"
        android:layout_gravity="center_horizontal"
        android:id="@+id/custom_drawer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/custom_drawer"
        android:fontFamily="@font/heavy"
        app:textColor_DARK="@color/bottom_sheet_text_dark"
        app:textColor_FOCUS="@color/bottom_sheet_text_focus"
        app:textColor_LIGHT="@color/bottom_sheet_text_light"
        app:textColor_SUN="@color/bottom_sheet_text_sun"/>
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/search_contact_photo_size"
        android:layout_marginBottom="42dp"
        android:layout_marginStart="@dimen/bottom_sheet_button_margin_start"
        android:layout_marginEnd="@dimen/bottom_sheet_button_margin_start"
        app:linearBackground_DARK="@color/app_edit_screen_button_inactive_light"
        app:linearBackground_FOCUS="@color/app_edit_screen_button_inactive_light"
        app:linearBackground_LIGHT="@color/app_edit_screen_button_inactive_light"
        app:linearBackground_SUN="@color/gray_10"
        app:linearLayout_corner_radius="22.3dp">
        <com.blloc.uicomponents.old.customviews.ThemeableEditText
            android:textSize="@dimen/bottom_sheet_description"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_40"
            android:id="@+id/et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/add_drawer_description_margin_horizontal"
            android:hint="@string/e_g_essentials_favorites"
            android:singleLine="true"
            android:maxLength="15"
            android:inputType="textCapSentences"
            android:textCursorDrawable="@null"
            android:fontFamily="@font/greycliff_cf_medium"
            android:paddingStart="@dimen/icon_top_and_left_margin"
            android:paddingEnd="@dimen/icon_top_and_left_margin"
            android:backgroundTint="@color/transparent"
            android:paddingVertical="@dimen/tile_cell_padding_horizontal"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_30"/>
    </com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_sheet_button_margin_bottom">
        <com.blloc.uicomponents.buttons.BllocButton
            android:textColor="@color/white"
            android:id="@+id/back_btn"
            android:background="@drawable/touch_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/bottom_sheet_button_margin_start"
            android:backgroundTint="@color/white"
            android:paddingHorizontal="@dimen/bottom_sheet_button_paddingH"
            android:paddingVertical="@dimen/tiles_recycler_paddingH"
            app:button_isFilled="false"
            app:button_text="@string/back_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BllocButtonCustomdrawer"/>
        <com.blloc.uicomponents.buttons.BllocButton
            android:id="@+id/next_btn"
            android:background="@drawable/touch_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/bottom_sheet_button_margin_start"
            android:paddingHorizontal="@dimen/bottom_sheet_button_paddingH"
            android:paddingVertical="@dimen/tiles_recycler_paddingH"
            app:button_isFilled="true"
            app:button_text="@string/next_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BllocButtonCustomdrawer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
