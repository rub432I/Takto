<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="@dimen/settings_item_paddingH"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.blloc.uicomponents.viewgroups.RoundedCornersLayout
            android:layout_width="150dp"
            android:layout_height="300dp"
            android:foreground="@drawable/foreground_selected_wallpaper"
            android:layout_marginHorizontal="10dp"
            app:cornerRadius="@dimen/wallpaper_chooser_item_corner_radius_plus_half_stroke">
            <ImageView
                android:id="@+id/wp_image_light"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.blloc.uicomponents.buttons.BllocButton
                android:layout_gravity="center"
                android:id="@+id/wp_label_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
                app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
                app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
                app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
                app:button_isFilled="true"
                app:button_text="@string/settings.wallpapers.select_light_wallpaper.buttonlabel"
                app:button_textColor_DARK="@color/button_textColor_dark"
                app:button_textColor_FOCUS="@color/button_textColor_focus"
                app:button_textColor_LIGHT="@color/button_textColor_light"
                app:button_textColor_SUN="@color/button_textColor_sun"/>
        </com.blloc.uicomponents.viewgroups.RoundedCornersLayout>
        <com.blloc.uicomponents.viewgroups.RoundedCornersLayout
            android:layout_width="150dp"
            android:layout_height="300dp"
            android:foreground="@drawable/foreground_selected_wallpaper"
            android:layout_marginHorizontal="10dp"
            app:cornerRadius="@dimen/wallpaper_chooser_item_corner_radius_plus_half_stroke">
            <ImageView
                android:id="@+id/wp_image_dark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.blloc.uicomponents.buttons.BllocButton
                android:layout_gravity="center"
                android:id="@+id/wp_label_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
                app:button_backgroundColor_FOCUS="@color/button_backgroundColor_focus"
                app:button_backgroundColor_LIGHT="@color/button_backgroundColor_light"
                app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
                app:button_isFilled="true"
                app:button_text="@string/settings.wallpapers.select_dark_wallpaper.buttonlabel"
                app:button_textColor_DARK="@color/button_textColor_dark"
                app:button_textColor_FOCUS="@color/button_textColor_focus"
                app:button_textColor_LIGHT="@color/button_textColor_light"
                app:button_textColor_SUN="@color/button_textColor_sun"/>
        </com.blloc.uicomponents.viewgroups.RoundedCornersLayout>
    </LinearLayout>
</FrameLayout>
