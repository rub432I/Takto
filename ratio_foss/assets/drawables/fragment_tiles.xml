<?xml version="1.0" encoding="utf-8"?>
<com.blloc.kotlintiles.ui.mainlist.TilesCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mainListFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/bottomSheetView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_draggable="true"
        app:behavior_peekHeight="200dp"
        app:layout_behavior="com.bllocosn.ui.main.appdrawer.RatioBottomSheetBehavior">
        <androidx.fragment.app.FragmentContainerView
            android:name="com.blloc.kotlintiles.ui.BottomSheetAppDrawerFragment"
            android:id="@+id/bottomSheetApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</com.blloc.kotlintiles.ui.mainlist.TilesCoordinatorLayout>
