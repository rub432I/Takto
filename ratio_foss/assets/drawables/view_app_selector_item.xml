<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_item_root"
    android:background="@drawable/touch_ripple"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_custom_icon"
        android:adjustViewBounds="true"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:id="@+id/app_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:fontFamily="@font/medium"
        android:layout_marginStart="8dp"
        android:layout_toStartOf="@+id/app_item_radio"
        android:layout_toEndOf="@+id/app_icon"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/app_item_radio"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/app_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor_DARK="@color/white"
        app:textColor_FOCUS="@color/white"
        app:textColor_LIGHT="@color/white"
        app:textColor_SUN="@color/button_backgroundColor_sun"/>
    <FrameLayout
        android:gravity="end"
        android:id="@+id/app_item_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.blloc.uicomponents.old.customviews.ThemeableRadioButton
            android:id="@+id/app_item_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:radioButtonColor_DARK="@color/white"
            app:radioButtonColor_FOCUS="@color/white"
            app:radioButtonColor_LIGHT="@color/white"
            app:radioButtonColor_SUN="@color/white"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
