<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottomsheet_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/bottomsheet_extra_padding_horizontal">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/bottom_sheet_title"
            android:gravity="center"
            android:id="@+id/bottom_sheet_title"
            android:paddingBottom="@dimen/bottomsheet_title_padding_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings.contributors.settinglabel"
            android:fontFamily="@font/heavy"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/about_contributors_description"
            android:gravity="center"
            android:id="@+id/contributors_description"
            android:paddingTop="@dimen/contributors_container_paddingT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings.about.contributors.description"
            android:fontFamily="@font/medium"
            android:paddingHorizontal="@dimen/contributors_title_paddingT"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/about_contributors_subtitle"
            android:gravity="center"
            android:id="@+id/contributors_subtitle_artisans"
            android:paddingTop="@dimen/contributors_title_paddingT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_contributors_artisans"
            android:fontFamily="@font/heavy"
            android:paddingHorizontal="@dimen/contributors_title_paddingT"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/artisans_container"
            android:paddingTop="@dimen/contributors_container_paddingT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:alignContent="stretch"
            app:alignItems="center"
            app:flexWrap="wrap"
            app:justifyContent="center"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/about_contributors_subtitle"
            android:gravity="center"
            android:id="@+id/contributors_subtitle_collaborators"
            android:paddingTop="@dimen/contributors_title_paddingT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_contributors_collaborators"
            android:fontFamily="@font/heavy"
            android:paddingHorizontal="@dimen/contributors_title_paddingT"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/collaborators_container"
            android:paddingTop="@dimen/contributors_container_paddingT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/about_contributors_subtitle"
            android:gravity="center"
            android:id="@+id/contributors_subtitle_testers_translators"
            android:paddingTop="@dimen/contributors_title_paddingT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_contributors_testers_translators"
            android:fontFamily="@font/heavy"
            android:paddingHorizontal="@dimen/contributors_title_paddingT"
            app:textColor_DARK="@color/bottom_sheet_text_dark"
            app:textColor_FOCUS="@color/bottom_sheet_text_focus"
            app:textColor_LIGHT="@color/bottom_sheet_text_light"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/contributors_container"
            android:paddingTop="@dimen/contributors_container_paddingT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:alignContent="stretch"
            app:alignItems="center"
            app:flexWrap="wrap"
            app:justifyContent="center"/>
    </LinearLayout>
</merge>
