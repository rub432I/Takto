<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/onboarding_buttons_container"
    android:paddingBottom="40dp"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:paddingHorizontal="40dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/skip_btn"
        android:background="@drawable/tile_shortcut_pill_background_black_outline"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:fontFamily="@font/bold"
        android:backgroundTint="#000000"
        android:layout_marginHorizontal="5dp">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="7dp"
            android:src="@drawable/ic_onboarding_btn_skip"
            android:tint="#343434"
            android:paddingVertical="10dp"/>
        <TextView
            android:textColor="#343434"
            android:gravity="center_vertical"
            android:id="@+id/skip_btn_text"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common.button.skip"
            android:fontFamily="@font/bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5dp"
            android:paddingVertical="7dp"
            android:autoSizeMaxTextSize="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/next_btn"
        android:background="@drawable/rounded_corners_50dp_fill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bold"
        android:backgroundTint="#343434"
        android:layout_marginHorizontal="5dp">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="7dp"
            android:src="@drawable/ic_onboarding_btn_next"
            android:paddingVertical="10dp"/>
        <TextView
            android:textColor="#e2ff00"
            android:gravity="center_vertical"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common.button.next"
            android:fontFamily="@font/bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5dp"
            android:paddingVertical="7dp"
            android:autoSizeMaxTextSize="12dp"/>
    </LinearLayout>
    <TextView
        android:textColor="#343434"
        android:gravity="right"
        android:id="@+id/step_counter_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1/5"
        android:layout_weight="1"
        android:fontFamily="@font/bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:autoSizeMaxTextSize="12dp"/>
</LinearLayout>
