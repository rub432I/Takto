<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_settings_devs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
        android:textSize="@dimen/settings_subtitle_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_subtitle_marginT"
        android:layout_marginBottom="@dimen/settings_subtitle_marginB"
        android:text="Tree"
        android:textAllCaps="true"
        android:fontFamily="@font/heavy"
        android:paddingHorizontal="@dimen/settings_subtitle_paddingH"
        app:textColor_DARK="@color/white"
        app:textColor_FOCUS="@color/white"
        app:textColor_LIGHT="@color/white"
        app:textColor_SUN="@color/gray_50"/>
    <com.bllocosn.ui.main.settings.item.SettingItemButton
        android:id="@+id/setting_item_delete_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_buttonIsFilled="false"
        app:settingItem_buttonText="@string/common.button.select"
        app:settingItem_icon="@drawable/settings_icon_devs_debug"
        app:settingItem_text="@string/tree.settings.devs.delete"/>
    <com.bllocosn.ui.main.settings.item.SettingItemButton
        android:id="@+id/setting_item_notification_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_buttonIsFilled="true"
        app:settingItem_buttonText="@string/common.button.show"
        app:settingItem_icon="@drawable/settings_icon_devs_debug"
        app:settingItem_text="@string/tree.settings.devs.notification_log"/>
    <com.bllocosn.ui.main.settings.item.SettingItemToggle
        android:id="@+id/setting_item_messages_debug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/settings_icon_devs_debug"
        app:settingItem_text="@string/tree.settings.devs.debug"/>
    <com.bllocosn.ui.main.settings.item.SettingItemButton
        android:id="@+id/setting_item_telegram_errors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_buttonIsFilled="false"
        app:settingItem_buttonText="@string/common.button.share"
        app:settingItem_icon="@drawable/settings_icon_devs_debug"
        app:settingItem_text="@string/tree.settings.devs.telegram_errors"/>
    <com.bllocosn.ui.main.settings.item.SettingItemButton
        android:id="@+id/setting_item_battery_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_buttonIsFilled="true"
        app:settingItem_buttonText="@string/common.button.share"
        app:settingItem_icon="@drawable/settings_icon_devs_debug"
        app:settingItem_text="@string/tree.settings.devs.battery_stats"/>
    <com.bllocosn.ui.main.settings.item.SettingItemButton
        android:id="@+id/setting_item_memory_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_buttonIsFilled="true"
        app:settingItem_buttonText="@string/common.button.share"
        app:settingItem_icon="@drawable/settings_icon_devs_debug"
        app:settingItem_text="@string/tree.settings.devs.memory_stats"/>
    <com.bllocosn.ui.main.settings.item.SettingItemButton
        android:id="@+id/setting_item_share_conversation_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_buttonIsFilled="false"
        app:settingItem_buttonText="@string/common.button.show"
        app:settingItem_icon="@drawable/settings_icon_root_timer"
        app:settingItem_text="@string/tree.settings.general.share_conversation_logs"/>
    <com.bllocosn.ui.main.settings.item.SettingItemButton
        android:id="@+id/setting_item_share_debug_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_buttonIsFilled="false"
        app:settingItem_buttonText="@string/common.button.share"
        app:settingItem_icon="@drawable/settings_icon_devs_debug"
        app:settingItem_text="@string/tree.settings.general.share_debug_logs"/>
</LinearLayout>
