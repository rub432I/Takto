<?xml version="1.0" encoding="utf-8"?>
<com.blloc.uicomponents.old.customviews.ThemeableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/bottom_sheet_max_height"
    app:linearBackground_DARK="@color/bottom_sheet_background_dark"
    app:linearBackground_FOCUS="@color/bottom_sheet_background_focus"
    app:linearBackground_LIGHT="@color/bottom_sheet_background_light"
    app:linearBackground_SUN="@color/bottom_sheet_background_sun"
    app:linearLayout_corner_radius="@dimen/bottom_sheet_corners">
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:layout_width="@dimen/bottom_sheet_handle_width"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:layout_marginTop="@dimen/bottom_sheet_handle_marginT"
        android:layout_marginBottom="@dimen/bottom_sheet_handle_marginB"
        app:linearBackground_DARK="@color/bottom_sheet_handle_dark"
        app:linearBackground_FOCUS="@color/bottom_sheet_handle_focus"
        app:linearBackground_LIGHT="@color/bottom_sheet_handle_light"
        app:linearBackground_SUN="@color/bottom_sheet_handle_sun"
        app:linearLayout_corner_radius="@dimen/bottom_sheet_handle_corners"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="@dimen/bottom_sheet_title_large"
        android:layout_gravity="center_horizontal"
        android:id="@+id/add_drawer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_drawer"
        android:fontFamily="@font/heavy"
        app:textColor_DARK="@color/bottom_sheet_text_dark"
        app:textColor_FOCUS="@color/bottom_sheet_text_focus"
        app:textColor_LIGHT="@color/bottom_sheet_text_light"
        app:textColor_SUN="@color/bottom_sheet_text_sun"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="@dimen/bottom_sheet_description"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/add_drawer_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/drawer_description_top"
        android:layout_marginBottom="@dimen/add_drawer_description_margin_bottom"
        android:text="@string/add_drawer_description"
        android:fontFamily="@font/light"
        android:layout_marginHorizontal="@dimen/add_drawer_description_margin_horizontal"
        app:textColor_DARK="@color/bottom_sheet_text_dark"
        app:textColor_FOCUS="@color/bottom_sheet_text_focus"
        app:textColor_LIGHT="@color/bottom_sheet_text_light"
        app:textColor_SUN="@color/bottom_sheet_text_sun"/>
    <com.blloc.uicomponents.view.SettingItem
        android:id="@+id/addCustomDrawerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin_separator"
        app:settingItem_icon="@drawable/ic_drawer_add"
        app:settingItem_text="@string/custom_drawer"/>
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_separator"
        android:layout_marginTop="@dimen/bottom_sheet_handle_corners"
        android:layout_marginHorizontal="@dimen/horizontal_margin_separator"
        app:linearBackground_DARK="@color/bottom_sheet_handle_dark"
        app:linearBackground_FOCUS="@color/bottom_sheet_handle_focus"
        app:linearBackground_LIGHT="@color/bottom_sheet_handle_light"
        app:linearBackground_SUN="@color/bottom_sheet_handle_sun"
        app:linearLayout_corner_radius="@dimen/bottom_sheet_handle_corners"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/drawer_items_margin_top"
        android:minHeight="@dimen/bottom_sheet_add_drawer_min_Height">
        <androidx.recyclerview.widget.RecyclerView
            android:gravity="top|center_horizontal"
            android:id="@+id/drawer_selector_rv"
            android:paddingBottom="@dimen/bottom_sheet_padding_bottom"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/bottom_sheet_fading_edge"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/horizontal_margin_separator"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/apps_load_pb"
            android:layout_width="@dimen/bottom_sheet_width"
            android:layout_height="@dimen/bottom_sheet_width"
            android:layout_margin="@dimen/space_app_name_icon"
            android:indeterminateTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
