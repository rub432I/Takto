<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/settings_item_paddingH"
    android:paddingVertical="@dimen/settings_item_paddingV">
    <com.blloc.uicomponents.old.customviews.ThemeableImageView
        android:id="@+id/setting_item_icon"
        android:layout_width="@dimen/settings_item_iconHeight"
        android:layout_height="@dimen/settings_item_iconHeight"
        android:layout_marginRight="@dimen/settings_item_icon_marginR"
        app:imageColor_DARK="@color/white"
        app:imageColor_FOCUS="@color/white"
        app:imageColor_LIGHT="@color/white"
        app:imageColor_SUN="@color/gray_50"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/settings_item_icon_marginR"
        android:layout_weight="1">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/settings_item_textSize"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/setting_item_text"
            android:paddingRight="@dimen/settings_item_text_marginR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medium"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/gray_50"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/setting_item_indicator"
            android:background="@drawable/background_corners_small"
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_marginRight="10dp"
            android:backgroundTint="@color/blloc_yellow"/>
        <SeekBar
            android:id="@+id/setting_item_slider"
            android:padding="0dp"
            android:clipToPadding="true"
            android:layout_width="60dp"
            android:layout_height="@dimen/settings_notification_slider_height"
            android:max="200"
            android:progressDrawable="@drawable/seekbar"
            android:thumb="@drawable/seekbar_thumb"
            android:thumbOffset="-4dp"
            android:shape="oval"
            android:min="100"/>
    </LinearLayout>
</LinearLayout>
