<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/header_height">
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="@dimen/header_text_size"
            android:textColor="#ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/conversation_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.ui.misc.tree_title"
            android:fontFamily="@font/heavy"
            android:layout_marginStart="15dp"
            android:letterSpacing="0.01"
            app:textColor_DARK="@color/title_dark"
            app:textColor_FOCUS="@color/title_focus"
            app:textColor_LIGHT="@color/title_light"
            app:textColor_SUN="@color/title_sun"/>
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
            android:textSize="9sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/conversation_title_superscript"
            android:paddingLeft="2dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tree.ui.misc.tree_beta"
            android:textAllCaps="true"
            android:fontFamily="@font/bold"
            app:textColor_DARK="@color/blloc_yellow"
            app:textColor_FOCUS="@color/blloc_yellow"
            app:textColor_LIGHT="@color/blloc_yellow"
            app:textColor_SUN="@color/gray_70"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="right"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header_buttons"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="33dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1">
        <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableImageView
            android:id="@+id/archive_btn"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_option_archive"
            android:adjustViewBounds="true"
            android:tint="#ffffff"
            android:alpha="1"
            app:imageColor_DARK="@color/header_buttons_dark"
            app:imageColor_FOCUS="@color/header_buttons_focus"
            app:imageColor_LIGHT="@color/header_buttons_light"
            app:imageColor_SUN="@color/header_buttons_sun"/>
    </LinearLayout>
</LinearLayout>
