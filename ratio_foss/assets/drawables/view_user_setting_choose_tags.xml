<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
        android:textSize="@dimen/user_settings_platform_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/user_settings_platform_title_margin"
        android:text="@string/tree.options.tags_one"
        android:fontFamily="@font/extra_bold"
        app:textColor_DARK="@color/white"
        app:textColor_FOCUS="@color/white"
        app:textColor_LIGHT="@color/white"
        app:textColor_SUN="#4d4d4d"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tags_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.blloc.bllocjavatree.ui.sections.conversation.settings.choosetags.AddTagSettingsView
        android:id="@+id/add_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
