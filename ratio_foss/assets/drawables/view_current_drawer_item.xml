<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_item_root"
    android:background="@drawable/touch_ripple"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:paddingHorizontal="@dimen/setting_item_padding_horizontal"
    android:paddingVertical="@dimen/setting_item_padding_vertical">
    <com.blloc.uicomponents.old.customviews.ThemeableImageView
        android:id="@+id/drawerIcon"
        android:layout_width="@dimen/standard_icon_size"
        android:layout_height="@dimen/standard_icon_size"
        android:layout_centerVertical="true"
        app:imageColor_DARK="@color/white"
        app:imageColor_FOCUS="@color/white"
        app:imageColor_LIGHT="@color/white"
        app:imageColor_SUN="@color/bottom_sheet_text_sun"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="@dimen/setting_item_text"
        android:gravity="center_vertical"
        android:id="@+id/drawer_name_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:fontFamily="@font/medium"
        android:layout_toStartOf="@+id/count_apps_text_layout"
        android:layout_toEndOf="@+id/drawerIcon"
        android:paddingHorizontal="@dimen/setting_item_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/count_apps_text_layout"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/drawerIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor_DARK="@color/white"
        app:textColor_FOCUS="@color/white"
        app:textColor_LIGHT="@color/white"
        app:textColor_SUN="@color/bottom_sheet_text_sun"/>
    <FrameLayout
        android:gravity="end"
        android:id="@+id/count_apps_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/bottom_sheet_text_small"
            android:id="@+id/count_apps_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/light"
            android:layout_marginStart="@dimen/standard_corner_radius_small"
            app:textColor_DARK="@color/white"
            app:textColor_FOCUS="@color/white"
            app:textColor_LIGHT="@color/white"
            app:textColor_SUN="@color/bottom_sheet_text_sun"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
