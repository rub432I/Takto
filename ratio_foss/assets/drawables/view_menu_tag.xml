<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/choose_tags_opacity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:linearBackground_DARK="@color/backgroundOpacity_dark"
        app:linearBackground_FOCUS="@color/backgroundOpacity_focus"
        app:linearBackground_LIGHT="@color/backgroundOpacity_light"
        app:linearBackground_SUN="@color/backgroundOpacity_sun"
        app:linearLayout_corner_radius="0dp">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/choose_tags_menu"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="400dp"
            android:paddingHorizontal="@dimen/conversation_options_hPadding"
            android:paddingVertical="@dimen/conversation_options_vPadding">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:paddingBottom="40dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                    android:textSize="@dimen/conversation_options_title"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tags_title"
                    android:paddingBottom="@dimen/merge_title_bottom_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage Tags"
                    android:maxLines="2"
                    android:fontFamily="@font/extra_bold"
                    app:textColor_DARK="@color/conversationOptionsText_dark"
                    app:textColor_FOCUS="@color/conversationOptionsText_focus"
                    app:textColor_LIGHT="@color/conversationOptionsText_light"
                    app:textColor_SUN="@color/conversationOptionsText_sun"/>
                <com.blloc.bllocjavatree.ui.themes.customviews.ThemeableTextView
                    android:textSize="@dimen/conversation_options_owner"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tags_owner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:fontFamily="@font/medium"
                    app:textColor_DARK="@color/conversationOptionsText_dark"
                    app:textColor_FOCUS="@color/conversationOptionsText_focus"
                    app:textColor_LIGHT="@color/conversationOptionsText_light"
                    app:textColor_SUN="@color/conversationOptionsText_sun"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/tags_list_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/tags_list"
                    android:background="@color/transparent"
                    android:paddingBottom="30dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.blloc.bllocjavatree.ui.sections.mainscreen.conversationoptions.TagsListElement
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <com.blloc.bllocjavatree.ui.sections.mainscreen.conversationoptions.TagsListElement
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/tags_options_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                        android:id="@+id/tags_option_add"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonIsFilled="false"
                        app:buttonText="@string/common.button.new"
                        app:buttonType="Add"/>
                    <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                        android:id="@+id/tags_option_confirm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonIsFilled="true"
                        app:buttonText="@string/common.button.done"
                        app:buttonType="Confirm"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/add_tag_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.blloc.bllocjavatree.ui.sections.mainscreen.conversationoptions.TagEditor
                    android:id="@+id/add_new_tag"
                    android:paddingBottom="30dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                        android:id="@+id/add_tag_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonIsFilled="false"
                        app:buttonText="@string/common.button.cancel"
                        app:buttonType="Cancel"/>
                    <com.blloc.bllocjavatree.ui.utils.MultiUseButton
                        android:id="@+id/add_tag_done"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonIsFilled="true"
                        app:buttonText="@string/common.button.done"
                        app:buttonType="Confirm"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.blloc.bllocjavatree.ui.themes.customviews.ThemeableLinearLayout>
</LinearLayout>
