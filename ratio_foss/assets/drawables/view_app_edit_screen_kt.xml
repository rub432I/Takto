<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.blloc.kotlintiles.ui.appeditscreen.utils.WallpaperView
        android:id="@+id/wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/intensity_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sections_container"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="12dp">
        <LinearLayout
            android:id="@+id/section_title"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rename_layout"
                android:clipChildren="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/app_name"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/heavy"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10dp"
                    android:autoSizeMaxTextSize="100dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffffff"
                    android:ellipsize="none"
                    android:id="@+id/app_description"
                    android:fadingEdgeLength="100dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="80dp"
                    android:text="App installed from Google Play Store\10Version 92.0.0.15.114"
                    android:maxLines="2"
                    android:layout_below="@+id/app_name"
                    android:translationY="-5dp"
                    android:requiresFadingEdge="horizontal"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/section_io_frame_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <com.blloc.blurview.BlurView
                android:id="@+id/section_io_blurbackrground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>&gt; 
            <LinearLayout
                android:id="@+id/section_io"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/storage_used_title_tv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/tiles.edit_app.storage"
                    android:maxLines="2"
                    android:layout_weight="1.05"
                    android:fontFamily="@font/bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="5dp"
                    android:autoSizeMaxTextSize="10dp"/>
                <TextView
                    android:textSize="25dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/storage_used_tv"
                    android:paddingLeft="5dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text=""
                    android:maxLines="1"
                    android:layout_weight="2"
                    android:fontFamily="@font/heavy"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="5dp"
                    android:autoSizeMaxTextSize="25dp"/>
                <View
                    android:id="@+id/storage_data_used_divider"
                    android:background="#323232"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="30dp"
                    android:layout_marginBottom="15dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/data_used_title_tv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/tiles.edit_app.data"
                    android:layout_weight="1"
                    android:fontFamily="@font/bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="5dp"
                    android:autoSizeMaxTextSize="10dp"/>
                <TextView
                    android:textSize="25dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/data_used_tv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text=""
                    android:maxLines="1"
                    android:layout_weight="2"
                    android:fontFamily="@font/heavy"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="5dp"
                    android:autoSizeMaxTextSize="25dp"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/section_usage_frame_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.blloc.blurview.BlurView
                android:id="@+id/section_usage_blurbackrground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>&gt; 
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/section_usage"
                android:paddingLeft="25dp"
                android:paddingTop="17dp"
                android:paddingRight="25dp"
                android:paddingBottom="17dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.blloc.kotlintiles.ui.appeditscreen.custom_views.usage.UsageView
                    android:id="@+id/usage_view"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/section_above_brightness_linear__layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/section_unknown"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="15dp"
                android:layout_weight="1.5">
                <FrameLayout
                    android:gravity="center_horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <com.blloc.blurview.BlurView
                        android:gravity="center_horizontal"
                        android:id="@+id/section_manage_app_blurbackrground"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:id="@+id/section_manage_app"
                        android:paddingLeft="0dp"
                        android:paddingTop="17dp"
                        android:paddingRight="0dp"
                        android:paddingBottom="17dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:id="@+id/btn_app_info"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <ImageView
                                android:id="@+id/btn_app_info_image"
                                android:padding="2dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="50dp"
                                android:layout_height="0dp"
                                android:src="@drawable/view_app_edit_screen_icon_app_info"
                                android:layout_weight="1"/>
                            <TextView
                                android:textColor="#ffffff"
                                android:gravity="bottom|center_horizontal"
                                android:id="@+id/btn_app_info_text"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:text="@string/common.button.info"
                                android:maxLines="1"
                                android:layout_weight="0.7"
                                android:fontFamily="@font/bold"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="6dp"
                                android:autoSizeMaxTextSize="12dp"/>
                        </LinearLayout>
                        <View
                            android:gravity="center_horizontal"
                            android:id="@+id/stop_delete_buttons_divider"
                            android:background="#323232"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="0dp"
                            android:layout_marginRight="0dp"/>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:id="@+id/btn_delete_app"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <ImageView
                                android:id="@+id/btn_delete_app_image"
                                android:padding="2dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="50dp"
                                android:layout_height="0dp"
                                android:src="@drawable/view_app_edit_screen_icon_delete_app"
                                android:layout_weight="1"/>
                            <TextView
                                android:textColor="#ffffff"
                                android:gravity="bottom|center_horizontal"
                                android:id="@+id/btn_delete_app_text"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:text="@string/common_uninstall"
                                android:maxLines="1"
                                android:layout_weight="0.7"
                                android:fontFamily="@font/bold"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="6dp"
                                android:autoSizeMaxTextSize="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout
                    android:paddingTop="17dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <com.blloc.blurview.BlurView
                        android:id="@+id/section_request_icon_blurbackrground"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <RelativeLayout
                        android:id="@+id/section_request_icon"
                        android:paddingLeft="25dp"
                        android:paddingTop="17dp"
                        android:paddingRight="25dp"
                        android:paddingBottom="17dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.blloc.kotlintiles.ui.appeditscreen.custom_views.RequestIconView
                            android:id="@+id/request_icon_view"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </RelativeLayout>
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/section_tile_color"
                android:background="@drawable/view_app_edit_screen_section_background_new"
                android:layout_width="0dp"
                android:layout_height="210dp"
                android:layout_marginTop="15dp"
                android:layout_weight="1">
                <com.blloc.blurview.BlurView
                    android:id="@+id/section_tile_color_blurbackrground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.blloc.kotlintiles.ui.appeditscreen.custom_views.tile_color_chooser.TileColorChooser
                    android:id="@+id/tile_color_chooser"
                    android:paddingLeft="@dimen/padding_tile_color_chooser"
                    android:paddingRight="@dimen/padding_tile_color_chooser"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/section_brightness"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <FrameLayout
            android:id="@+id/section_app_settings_frame_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="100dp">
            <com.blloc.blurview.BlurView
                android:id="@+id/section_app_settings_blurbackrground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/section_app_settings"
                android:background="@drawable/view_app_edit_screen_section_background_new"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="17dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/btn_color_mode"
                    android:clipChildren="false"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/btn_color_mode_image"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:src="@drawable/view_app_edit_screen_icon_color"
                        android:layout_weight="1.3"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:gravity="top|center_horizontal"
                        android:id="@+id/btn_color_mode_text"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/tiles.edit_app.option.color"
                        android:layout_weight="1"
                        android:fontFamily="@font/bold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/btn_lock"
                    android:clipChildren="false"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/btn_lock_image"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:src="@drawable/view_app_edit_screen_icon_lock"
                        android:layout_weight="1.3"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:gravity="top|center_horizontal"
                        android:id="@+id/btn_lock_text"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/tiles.edit_app.option.lock"
                        android:layout_weight="1"
                        android:fontFamily="@font/bold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/btn_mute"
                    android:clipChildren="false"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/btn_mute_image"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:src="@drawable/view_app_edit_screen_icon_mute"
                        android:layout_weight="1.3"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:gravity="top|center_horizontal"
                        android:id="@+id/btn_mute_text"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/tiles.edit_app.option.mute"
                        android:layout_weight="1"
                        android:fontFamily="@font/bold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/btn_expand"
                    android:clipChildren="false"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/btn_expand_image"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:src="@drawable/view_app_edit_screen_icon_expand"
                        android:layout_weight="1.3"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:gravity="top|center_horizontal"
                        android:id="@+id/btn_expand_text"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="@string/tiles.edit_app.option.expand"
                        android:layout_weight="1"
                        android:fontFamily="@font/bold"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="50.4dp"
            android:layout_marginBottom="12dp">
            <com.blloc.blurview.BlurView
                android:id="@+id/save_btn_blurbackrground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/save_btn"
                android:background="@drawable/view_app_edit_screen_save_button_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/common.button.close"
                android:fontFamily="@font/bold"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
