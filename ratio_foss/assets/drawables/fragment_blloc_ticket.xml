<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingTop="50dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:id="@+id/ticket_top_container"
        android:background="@drawable/ticket_top_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <include layout="@layout/view_ticket_top_pdf_format"/>
    </LinearLayout>
    <ScrollView
        android:background="@drawable/ticket_bottom_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/ticket_bottom_padding">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/ticket_bottom_padding"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <ImageView
                    android:textColor="@color/ticket_bottom_text_title"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/blloc_ticket_type"
                    android:scaleType="fitStart"
                    android:text="BllocTicket"
                    android:layout_weight="1"
                    android:fontFamily="@font/heavy"
                    android:paddingVertical="10dp"/>
                <TextView
                    android:textSize="8dp"
                    android:textColor="@color/ticket_bottom_text_title"
                    android:gravity="top"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="5dp"
                    android:text="Current time"
                    android:fontFamily="@font/light"/>
                <TextClock
                    android:textSize="25dp"
                    android:textColor="@color/ticket_bottom_text_title"
                    android:gravity="center_vertical"
                    android:id="@+id/current_time_tc"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/heavy"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/ticket_bottom_text_title"
                    android:gravity="center"
                    android:id="@+id/departure_airport_IATATV"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:text="JFK"
                    android:layout_weight="1"
                    android:fontFamily="@font/heavy"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="30dp"
                    android:autoSizeMaxTextSize="120dp"/>
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ticket_arrow_right"
                    android:layout_marginHorizontal="0dp"
                    android:paddingHorizontal="10dp"/>
                <TextView
                    android:textColor="@color/ticket_bottom_text_title"
                    android:gravity="center"
                    android:id="@+id/arrival_airport_IATATV"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:text="TXL"
                    android:layout_weight="1"
                    android:fontFamily="@font/heavy"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="30dp"
                    android:autoSizeMaxTextSize="120dp"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="80dp">
                <ImageView
                    android:id="@+id/icon_location_1"
                    android:padding="2dp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ticket_icon_location"
                    app:layout_constraintBottom_toTopOf="@+id/icon_time_1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="spread"/>
                <ImageView
                    android:id="@+id/icon_time_1"
                    android:padding="2dp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ticket_icon_time"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/icon_location_1"
                    app:layout_constraintVertical_chainStyle="spread"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ticket_bottom_text_title"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/departure_location"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="20dp"
                    android:maxLines="1"
                    android:maxEms="8"
                    android:fontFamily="@font/medium"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_location_1"
                    app:layout_constraintLeft_toRightOf="@+id/icon_location_1"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ticket_bottom_text_title"
                    android:gravity="center_vertical"
                    android:id="@+id/current_time_origin"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Local"
                    android:fontFamily="@font/bold"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_time_1"
                    app:layout_constraintLeft_toRightOf="@+id/icon_time_1"
                    app:layout_constraintTop_toTopOf="@+id/icon_time_1"/>
                <TextClock
                    android:textSize="12dp"
                    android:textColor="@color/ticket_bottom_text_title"
                    android:gravity="center"
                    android:id="@+id/departure_local_time"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:fontFamily="@font/medium"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_time_1"
                    app:layout_constraintLeft_toRightOf="@+id/current_time_origin"
                    app:layout_constraintTop_toTopOf="@+id/current_time_origin"/>
                <TextClock
                    android:textSize="12dp"
                    android:textColor="@color/ticket_bottom_text_title"
                    android:gravity="center"
                    android:id="@+id/arrival_local_time"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:fontFamily="@font/medium"
                    app:layout_constraintBottom_toBottomOf="@+id/departure_local_time"
                    app:layout_constraintLeft_toRightOf="@+id/current_time_destination"
                    app:layout_constraintTop_toTopOf="@+id/current_time_destination"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ticket_bottom_text_title"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/arrival_location"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:maxEms="8"
                    android:fontFamily="@font/medium"
                    app:layout_constraintBottom_toBottomOf="@+id/departure_location"
                    app:layout_constraintRight_toRightOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ticket_bottom_text_title"
                    android:gravity="center_vertical"
                    android:id="@+id/current_time_destination"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Local"
                    android:fontFamily="@font/bold"
                    app:layout_constraintBottom_toBottomOf="@+id/icon_time_2"
                    app:layout_constraintLeft_toRightOf="@+id/icon_time_2"
                    app:layout_constraintTop_toTopOf="@+id/icon_time_2"/>
                <ImageView
                    android:id="@+id/icon_location_2"
                    android:padding="2dp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ticket_icon_location"
                    app:layout_constraintBottom_toTopOf="@+id/icon_time_1"
                    app:layout_constraintRight_toLeftOf="@+id/arrival_location"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="spread"/>
                <ImageView
                    android:id="@+id/icon_time_2"
                    android:padding="2dp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ticket_icon_time"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="@+id/icon_location_2"
                    app:layout_constraintTop_toBottomOf="@+id/icon_location_1"
                    app:layout_constraintVertical_chainStyle="spread"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1.2">
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Departure time"
                        android:fontFamily="@font/medium"/>
                    <TextView
                        android:textSize="40dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:id="@+id/departure_time_TV"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:text="7:35"
                        android:layout_weight="1"
                        android:fontFamily="@font/heavy"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arrival time"
                        android:fontFamily="@font/medium"/>
                    <TextView
                        android:textSize="40dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:id="@+id/arrival_time_TV"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:text="7:35"
                        android:layout_weight="1"
                        android:fontFamily="@font/heavy"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gate"
                        android:fontFamily="@font/medium"/>
                    <TextView
                        android:textSize="40dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:id="@+id/gate_TV"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:text="7:35"
                        android:layout_weight="1"
                        android:fontFamily="@font/heavy"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terminal"
                        android:fontFamily="@font/medium"/>
                    <TextView
                        android:textSize="40dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:id="@+id/terminal_TV"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:text="7:35"
                        android:layout_weight="1"
                        android:fontFamily="@font/heavy"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp">
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Group/Zone"
                        android:fontFamily="@font/medium"/>
                    <TextView
                        android:textSize="40dp"
                        android:textColor="@color/ticket_bottom_text_title"
                        android:gravity="center"
                        android:id="@+id/group_zone_TV"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="7:35"
                        android:fontFamily="@font/heavy"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="500px"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
