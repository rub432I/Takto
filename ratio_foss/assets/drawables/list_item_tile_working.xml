<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/roo_view_rl"
    android:paddingLeft="6dp"
    android:paddingTop="3dp"
    android:paddingRight="6dp"
    android:paddingBottom="9dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="144dp">
    <View
        android:background="#00000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="-4dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="-4dp"
        android:layout_marginBottom="-6dp"/>
    <View
        android:id="@+id/tile_background"
        android:background="@drawable/tile_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.blloc.bllocjavatiles.custom_views.TileViewBackground
        android:id="@+id/tile_view_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:endColorHighlighted="#a24a3d"
        app:pillHeight="@dimen/tile_notification_indicator_height"
        app:pillPaddingRight="@dimen/a"
        app:pillPaddingTop="@dimen/a"
        app:pillWidth="@dimen/tile_notification_indicator_width"/>
    <ImageView
        android:id="@+id/app_icon_iv"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="36dp"
        android:src="@drawable/test_app_icon_1"/>
    <View
        android:id="@+id/notification_indicator"
        android:background="@drawable/tile_notification_indicator"
        android:layout_width="@dimen/tile_notification_indicator_width"
        android:layout_height="@dimen/tile_notification_indicator_height"
        android:layout_marginTop="@dimen/a"
        android:layout_marginRight="@dimen/a"
        android:layout_alignParentRight="true"/>
    <View
        android:id="@+id/notification_indicator_frame"
        android:background="@drawable/tile_notification_indicator_background"
        android:layout_width="@dimen/tile_notification_indicator_width"
        android:layout_height="@dimen/tile_notification_indicator_height"
        android:layout_marginTop="@dimen/a"
        android:layout_marginRight="@dimen/a"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/notification_number_tv"
        android:layout_width="@dimen/a"
        android:layout_height="@dimen/tile_notification_indicator_height"
        android:layout_marginTop="3dp"
        android:layout_marginRight="@dimen/a"
        android:text="8"
        android:layout_below="@+id/notification_indicator_frame"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif-black"/>
    <TextView
        android:textSize="13.5dp"
        android:textColor="@color/blloc_tiles_app_text"
        android:ellipsize="none"
        android:id="@+id/app_title_tv"
        android:paddingTop="5dp"
        android:fadingEdgeLength="100dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/a"
        android:layout_marginRight="@dimen/a"
        android:text="Messages"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:requiresFadingEdge="horizontal"
        android:fontFamily="sans-serif-black"/>
    <View
        android:id="@+id/app_title_gradient"
        android:background="@drawable/tile_title_gradient"
        android:layout_width="30dp"
        android:layout_height="25dp"
        android:layout_marginRight="@dimen/a"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:translationY="5dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/blloc_tiles_app_text"
        android:id="@+id/app_time_usage_tv"
        android:paddingLeft="@dimen/a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/usage_time_margin_bottom"
        android:text="1h 37m"
        android:layout_alignParentBottom="true"
        android:translationY="-1dp"
        android:fontFamily="sans-serif-thin"/>
    <ImageView
        android:id="@+id/tile_indicator_2"
        android:padding="0.7dp"
        android:layout_width="@dimen/a"
        android:layout_height="@dimen/a"
        android:layout_marginBottom="@dimen/a"
        android:src="@drawable/tile_indicator_lock"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:alpha="1"/>
    <ImageView
        android:id="@+id/tile_indicator_1"
        android:padding="0.7dp"
        android:layout_width="@dimen/a"
        android:layout_height="@dimen/a"
        android:layout_marginRight="9dp"
        android:layout_marginBottom="@dimen/a"
        android:src="@drawable/tile_indicator_moon"
        android:layout_toLeftOf="@+id/tile_indicator_2"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:alpha="1"/>
    <ImageView
        android:id="@+id/tile_indicator_3"
        android:padding="0.7dp"
        android:layout_width="@dimen/a"
        android:layout_height="@dimen/a"
        android:layout_marginLeft="9dp"
        android:layout_marginBottom="@dimen/a"
        android:src="@drawable/tile_indicator_bell_slashed"
        android:layout_toRightOf="@+id/tile_indicator_2"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:alpha="1"/>
    <View
        android:background="#ff0000"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_centerInParent="true"/>
    <View
        android:background="#ff0000"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/a"
        android:layout_alignParentRight="true"/>
    <View
        android:background="#ff0000"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/usage_time_margin_bottom"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
