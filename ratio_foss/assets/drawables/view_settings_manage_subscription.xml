<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/bottom_sheet_title"
                android:gravity="center"
                android:id="@+id/bottom_sheet_title"
                android:paddingBottom="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_about_subscription_details"
                android:fontFamily="@font/heavy"
                app:textColor_DARK="@color/bottom_sheet_text_dark"
                app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                app:textColor_LIGHT="@color/bottom_sheet_text_light"
                app:textColor_SUN="@color/bottom_sheet_text_sun"/>
            <com.blloc.uicomponents.old.customviews.ThemeableTextView
                android:textSize="@dimen/about_contributors_description"
                android:gravity="center"
                android:id="@+id/bottom_sheet_details_start"
                android:paddingTop="@dimen/about_contributors_view_paddingT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_about_subscription_member"
                android:fontFamily="@font/medium"
                app:textColor_DARK="@color/bottom_sheet_text_dark"
                app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                app:textColor_LIGHT="@color/bottom_sheet_text_light"
                app:textColor_SUN="@color/bottom_sheet_text_sun"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="@dimen/about_contributors_view_paddingT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.blloc.uicomponents.old.customviews.ThemeableTextView
                    android:textSize="@dimen/about_contributors_description"
                    android:gravity="center"
                    android:id="@+id/bottom_sheet_plan"
                    android:paddingBottom="@dimen/about_contributors_item_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_about_subscription_plan"
                    android:alpha="0.7"
                    android:fontFamily="@font/medium"
                    app:textColor_DARK="@color/bottom_sheet_text_dark"
                    app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                    app:textColor_LIGHT="@color/bottom_sheet_text_light"
                    app:textColor_SUN="@color/bottom_sheet_text_sun"/>
                <com.blloc.uicomponents.old.customviews.ThemeableTextView
                    android:textSize="@dimen/about_contributors_description"
                    android:id="@+id/bottom_sheet_plan_details"
                    android:paddingBottom="@dimen/about_contributors_item_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    app:textColor_DARK="@color/bottom_sheet_text_dark"
                    app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                    app:textColor_LIGHT="@color/bottom_sheet_text_light"
                    app:textColor_SUN="@color/bottom_sheet_text_sun"/>
                <com.blloc.uicomponents.old.customviews.ThemeableTextView
                    android:textSize="@dimen/about_contributors_description"
                    android:gravity="center"
                    android:id="@+id/bottom_sheet_next_payment"
                    android:paddingBottom="@dimen/about_contributors_item_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_about_subscription_next_payment"
                    android:alpha="0.7"
                    android:fontFamily="@font/medium"
                    app:textColor_DARK="@color/bottom_sheet_text_dark"
                    app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                    app:textColor_LIGHT="@color/bottom_sheet_text_light"
                    app:textColor_SUN="@color/bottom_sheet_text_sun"/>
                <com.blloc.uicomponents.old.customviews.ThemeableTextView
                    android:textSize="@dimen/about_contributors_description"
                    android:id="@+id/bottom_sheet_next_payment_details"
                    android:paddingBottom="@dimen/about_contributors_item_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    app:textColor_DARK="@color/bottom_sheet_text_dark"
                    app:textColor_FOCUS="@color/bottom_sheet_text_focus"
                    app:textColor_LIGHT="@color/bottom_sheet_text_light"
                    app:textColor_SUN="@color/bottom_sheet_text_sun"/>
            </LinearLayout>
        </LinearLayout>
        <com.blloc.uicomponents.buttons.BllocButton
            android:id="@+id/bottom_sheet_button_playstore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:button_backgroundColor_DARK="@color/button_backgroundColor_dark"
            app:button_backgroundColor_FOCUS="@color/button_backgroundColor_dark"
            app:button_backgroundColor_LIGHT="@color/button_backgroundColor_sun"
            app:button_backgroundColor_SUN="@color/button_backgroundColor_sun"
            app:button_isFilled="true"
            app:button_text="@string/settings_manage_subscription_playstore"
            app:button_textColor_DARK="@color/button_textColor_dark"
            app:button_textColor_FOCUS="@color/button_textColor_dark"
            app:button_textColor_LIGHT="@color/button_textColor_sun"
            app:button_textColor_SUN="@color/button_textColor_sun"/>
    </LinearLayout>
</merge>
