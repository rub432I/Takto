<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <com.blloc.uicomponents.view.BllocSlideSelectorWithAccentColor
        android:id="@+id/slideSelector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wallpaper_chooser_slider_height"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="@dimen/settings_item_paddingH"
        app:option1Text="@string/settings.wallpapers.switch_options.use_ratio_wallpapers"
        app:option2Text="@string/settings.wallpapers.switch_options.use_custom_wallpapers"/>
    <com.bllocosn.ui.main.widgets.wallpaperchooser.RatioWallpaperListView
        android:id="@+id/wallpaperListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="0dp"/>
    <FrameLayout
        android:id="@+id/customWallpaperFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="0dp">
        <include layout="@layout/view_wallpaper_custom_wp_chooser"/>
    </FrameLayout>
    <com.blloc.uicomponents.view.SettingItem
        android:id="@+id/setting_item_apply_light_wp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/inputaction_theme_light"
        app:settingItem_text="@string/settings.wallpapers.apply_light_to_system.label"/>
    <com.blloc.uicomponents.view.SettingItem
        android:id="@+id/setting_item_apply_dark_wp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:settingItem_icon="@drawable/inputaction_theme_dark"
        app:settingItem_text="@string/settings.wallpapers.apply_dark_to_system.label"/>
</LinearLayout>
