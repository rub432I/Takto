<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/search_internal_item_padding"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layoutHighlight"
        layout="@layout/layout_search_highlight"/>
    <com.blloc.uicomponents.old.customviews.ThemeableLottieView
        android:id="@+id/fingerprintView"
        android:background="@drawable/lottie_clip_drawable"
        android:visibility="gone"
        android:layout_width="@dimen/dock_finger_print_size_small"
        android:layout_height="@dimen/dock_finger_print_size_small"
        app:layout_constraintBottom_toBottomOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline"
        app:lottie_rawRes="@raw/fingerprint_dock"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4"/>
    <com.blloc.kotlintiles.ui.dock.DockAppIconView
        android:id="@+id/searchAppIcon"
        android:layout_width="@dimen/icon_size_small"
        android:layout_height="@dimen/icon_size_small"
        android:scaleType="fitCenter"
        app:imageColor_DARK="@color/docktile_icon_colortint_DARK"
        app:imageColor_FOCUS="@color/docktile_icon_colortint_FOCUS"
        app:imageColor_LIGHT="@color/docktile_icon_colortint_LIGHT"
        app:imageColor_SUN="@color/docktile_icon_colortint_SUN"
        app:layout_constraintBottom_toBottomOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline"/>
    <View
        android:id="@+id/searchNotificationDot"
        android:background="@drawable/notification_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:translationX="-3dp"
        android:translationY="3dp"
        app:layout_constraintBottom_toTopOf="@+id/searchAppIcon"
        app:layout_constraintStart_toEndOf="@+id/searchAppIcon"/>
    <com.blloc.uicomponents.old.customviews.ThemeableTextView
        android:textSize="10sp"
        android:ellipsize="end"
        android:id="@+id/searchAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="1"
        android:fontFamily="@font/medium"
        android:paddingHorizontal="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchAppIcon"
        app:textColor_DARK="@color/gray_25"
        app:textColor_FOCUS="@color/gray_25"
        app:textColor_LIGHT="@color/gray_20"
        app:textColor_SUN="@color/gray_40"/>
    <include
        android:id="@+id/layoutRipple"
        layout="@layout/layout_search_item_ripple_overlay"/>
</androidx.constraintlayout.widget.ConstraintLayout>
