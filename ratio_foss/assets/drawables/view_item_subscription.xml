<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/sales_page_subscription_paddingH">
    <com.blloc.uicomponents.old.customviews.ThemeableSelectableLinearLayout
        android:orientation="vertical"
        android:id="@+id/item_container"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="10dp"
        app:selectableCornerRadius="@dimen/corner_radius_large"
        app:selectedBackground_DARK="@color/salespage_subscriptionbg_selected_dark"
        app:selectedBackground_FOCUS="@color/salespage_subscriptionbg_selected_dark"
        app:selectedBackground_LIGHT="@color/salespage_subscriptionbg_selected_light"
        app:selectedBackground_SUN="@color/salespage_subscriptionbg_selected_light"
        app:unselectedBackground_DARK="@color/salespage_subscriptionbg_dark"
        app:unselectedBackground_FOCUS="@color/salespage_subscriptionbg_dark"
        app:unselectedBackground_LIGHT="@color/salespage_subscriptionbg_light"
        app:unselectedBackground_SUN="@color/salespage_subscriptionbg_light">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/sales_page_subscription_title"
            android:id="@+id/item_title"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:fontFamily="@font/heavy"
            app:textColor_DARK="@color/salespage_text_dark"
            app:textColor_FOCUS="@color/salespage_text_dark"
            app:textColor_LIGHT="@color/salespage_text_light"
            app:textColor_SUN="@color/salespage_text_light"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/sales_page_subscription_price"
            android:id="@+id/item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            app:textColor_DARK="@color/salespage_text_dark"
            app:textColor_FOCUS="@color/salespage_text_dark"
            app:textColor_LIGHT="@color/salespage_text_light"
            app:textColor_SUN="@color/salespage_text_light"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/sales_page_subscription_price"
            android:id="@+id/item_full_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:fontFamily="@font/medium"
            app:textColor_DARK="@color/salespage_text_dark"
            app:textColor_FOCUS="@color/salespage_text_dark"
            app:textColor_LIGHT="@color/salespage_text_light"
            app:textColor_SUN="@color/salespage_text_light"/>
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/sales_page_subscription_item_trial"
            android:id="@+id/item_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="try free for 7 days"
            android:fontFamily="@font/medium"
            app:textColor_DARK="@color/salespage_text_dark"
            app:textColor_FOCUS="@color/salespage_text_dark"
            app:textColor_LIGHT="@color/salespage_text_light"
            app:textColor_SUN="@color/salespage_text_light"/>
    </com.blloc.uicomponents.old.customviews.ThemeableSelectableLinearLayout>
    <com.blloc.uicomponents.old.customviews.ThemeableView
        android:id="@+id/item_selected_frame"
        android:background="@drawable/rounded_corners_10dp_outline"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        app:background_DARK="@color/salespage_text_dark"
        app:background_FOCUS="@color/salespage_text_dark"
        app:background_LIGHT="@color/salespage_text_light"
        app:background_SUN="@color/salespage_text_light"/>
    <com.blloc.uicomponents.old.customviews.ThemeableLinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/item_banner_container"
        android:background="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_above="@+id/item_container"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        app:linearBackground_DARK="@color/salespage_buttonbg_dark"
        app:linearBackground_FOCUS="@color/salespage_buttonbg_dark"
        app:linearBackground_LIGHT="@color/salespage_buttonbg_light"
        app:linearBackground_SUN="@color/salespage_buttonbg_light"
        app:linearLayout_corner_radius="50dp">
        <com.blloc.uicomponents.old.customviews.ThemeableTextView
            android:textSize="@dimen/sales_page_subscription_banner"
            android:id="@+id/item_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One-Time"
            android:maxLines="1"
            android:fontFamily="@font/bold"
            app:textColor_DARK="@color/salespage_buttontext_dark"
            app:textColor_FOCUS="@color/salespage_buttontext_dark"
            app:textColor_LIGHT="@color/salespage_buttontext_light"
            app:textColor_SUN="@color/salespage_buttontext_light"/>
    </com.blloc.uicomponents.old.customviews.ThemeableLinearLayout>
</FrameLayout>
