<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true">
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/header_edit_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="12dp">
        <TextView
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/delete_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:fontFamily="@font/bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5dp"
            android:layout_marginHorizontal="5dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:autoSizeMaxTextSize="12dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/change_icon_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:layout_marginHorizontal="5dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="7dp"
                android:src="@drawable/ic_header_edit_menu_icons"
                android:fontFamily="@font/bold"
                android:paddingVertical="12dp"/>
            <TextView
                android:textColor="#000000"
                android:gravity="center_vertical"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change icon"
                android:fontFamily="@font/bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="5dp"
                android:paddingVertical="10dp"
                android:autoSizeMaxTextSize="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/reorder_alphabetically_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:layout_marginHorizontal="5dp">
            <ImageView
                android:id="@+id/reorder_alphabetically_btn_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="7dp"
                android:src="@drawable/ic_header_edit_menu_icons"
                android:fontFamily="@font/bold"
                android:paddingVertical="12dp"/>
            <TextView
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/reorder_alphabetically_btn_text"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A-Z order"
                android:fontFamily="@font/bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="5dp"
                android:layout_marginHorizontal="5dp"
                android:paddingVertical="10dp"
                android:autoSizeMaxTextSize="12dp"/>
        </LinearLayout>
        <TextView
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/lock_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lock"
            android:fontFamily="@font/bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5dp"
            android:layout_marginHorizontal="5dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:autoSizeMaxTextSize="12dp"/>
        <TextView
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/edit_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:fontFamily="@font/bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="5dp"
            android:layout_marginHorizontal="5dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:autoSizeMaxTextSize="12dp"/>
    </LinearLayout>
</HorizontalScrollView>
